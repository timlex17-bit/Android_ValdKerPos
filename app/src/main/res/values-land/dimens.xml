<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="cart_drawer_max_width">420dp</dimen>
    <dimen name="dialog_card_max_width">640dp</dimen>
    <!--
      Tinggi isi dialog pada ponsel yang dimiringkan.

      Ketiga angka ini sebelumnya sama atau hampir sama dengan nilai potret -
      420dp untuk area gulir, 560dp untuk checkout - padahal SELURUH layar
      dalam lanskap hanya sekitar 360dp. Karena dipakai sebagai layout_height
      mati (bukan maxHeight; ScrollView tidak punya atribut itu), badan
      dialognya sendiri sudah lebih tinggi daripada layar, sehingga judul dan
      tombolnya terdorong keluar dan tidak ada cara mencapainya.

      Sekarang disisakan ruang untuk judul dan bilah tombol: sekitar 200dp
      untuk badan yang bergulir, dan daftar di dalamnya lebih pendek lagi.
    -->
    <dimen name="dialog_checkout_max_height">250dp</dimen>
    <dimen name="dialog_scroll_max_height">200dp</dimen>
    <dimen name="dialog_list_height">120dp</dimen>
    <dimen name="scanner_card_max_width">480dp</dimen>
    <dimen name="scanner_card_max_height">300dp</dimen>
    <dimen name="scanner_frame_size">200dp</dimen>
    <dimen name="report_chart_height">240dp</dimen>
    <dimen name="product_card_image_height">210dp</dimen>

    <!--
      Lanskap ponsel punya tinggi layar yang sangat terbatas (kerap di bawah
      400dp), jadi bilah atas dipendekkan agar isi layar tetap kebagian ruang.
    -->
    <dimen name="topbar_min_height">48dp</dimen>

    <!--
      Lanskap ponsel: tinggi layar kerap di bawah 400dp, jadi komponen kasir
      dipendekkan. Nilai yang tidak disebut di sini sengaja mewarisi values/.
      Tablet tidak terpengaruh: smallest-width mengalahkan orientasi dalam
      urutan pemilihan sumber daya Android, jadi tablet dalam lanskap tetap
      membaca values-sw600dp/.
    -->
    <dimen name="pos_header_logo_size">34dp</dimen>
    <dimen name="pos_header_action_size">38dp</dimen>

    <dimen name="workshop_avatar_size">32dp</dimen>
    <dimen name="workshop_header_row_min_height">34dp</dimen>
    <dimen name="workshop_draft_add_chip_size">30dp</dimen>
    <dimen name="workshop_draft_chip_min_height">30dp</dimen>
    <dimen name="workshop_summary_row_min_height">28dp</dimen>
    <dimen name="workshop_customer_button_min_width">42dp</dimen>
    <dimen name="workshop_customer_button_min_height">28dp</dimen>
    <dimen name="workshop_status_chip_min_height">22dp</dimen>
    <dimen name="workshop_stats_row_min_height">48dp</dimen>
    <dimen name="workshop_checkout_row_min_height">44dp</dimen>
    <dimen name="workshop_checkout_button_min_height">44dp</dimen>
    <dimen name="workshop_action_button_min_height">44dp</dimen>

    <!--
      Layar masuk & aktivasi pada ponsel yang dimiringkan. Tinggi layar
      tinggal sekitar 360dp dan papan ketik memakan separuhnya, jadi kepala
      ungunya dipendekkan supaya kolom isian tetap kelihatan tanpa digulir.

      Tablet TIDAK terkena berkas ini meski sedang mendatar: values-sw600dp
      menang atas values-land dalam urutan pemilihan sumber daya Android.
    -->
    <dimen name="login_logo_size">40dp</dimen>
    <dimen name="login_logo_text">19sp</dimen>
    <dimen name="login_app_name_text">19sp</dimen>
    <dimen name="login_hero_padding_top">10dp</dimen>
    <dimen name="login_hero_padding_bottom">14dp</dimen>
    <dimen name="login_sheet_radius">22dp</dimen>
    <dimen name="login_sheet_padding_top">18dp</dimen>
    <dimen name="login_sheet_padding_bottom">16dp</dimen>
</resources>
