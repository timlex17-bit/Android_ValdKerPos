<?xml version="1.0" encoding="utf-8"?>
<!--
  Kasir restoran - tablet (lebar terkecil >= 600dp).

  Bedanya dengan ponsel hanya satu: keranjang berdiri sebagai kolom tetap di
  sisi kanan, bukan laci yang menutupi menu. Kasir bisa menambah item dan
  melihat totalnya pada saat yang sama, yang justru paling berguna ketika
  layarnya besar.

  KEPALA DAN AKSI CEPAT TIDAK DITULIS ULANG DI SINI

  Berkas ini sebelumnya memuat salinan lengkap kepala kasir, dan salinan itu
  berhenti ikut diperbarui: setelah desain baru masuk, tablet masih
  menampilkan kepala putih lama berikut kotak cari bergaya lama, sementara
  ponsel sudah ungu. Tidak ada galat yang timbul - varian yang tertinggal
  tetap ikut dikompilasi dengan baik. Sekarang kepala dan strip aksi cepat
  diambil lewat <include> dari berkas yang sama dengan ponsel, dan yang
  tersisa di sini benar-benar hanya susunan kolomnya.

  Dua akibat yang disengaja:

  1. Tidak ada tombol keranjang yang aktif di bilah atas - view_pos_header_resto
     memang memuatnya, tapi MainActivity menyembunyikannya di tata letak ini
     karena keranjang sudah selalu terlihat.
  2. Bilah kategori berhenti di tepi kolom keranjang, bukan di tepi layar.
     Kategori milik daftar menu; melebarkannya ke bawah keranjang membuat
     kolom keranjang seolah mengambang.

  Untuk retail dan bengkel, MainActivity.applyBusinessTypeUi() menyembunyikan
  kolom keranjang dan melebarkan fragmentContainer sampai tepi kanan: keduanya
  punya layar kasir sendiri yang sudah memuat keranjangnya.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_ground"
    android:clipToPadding="false">

    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pos_accent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        layout="@layout/view_pos_header_resto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Baris bon. Duduk di bawah kepala, di atas latar lavender - sama persis
      dengan kasir retail dan bengkel.

      Sempat HILANG sama sekali. Sebelum kepala restoran ditulis ulang, baris
      bon ada di dalamnya lewat <include view_pos_draft_row>; penulisan ulang
      itu tidak membawanya serta, dan karena MainActivity menjaga diri dengan
      "if (chipGroupDrafts == null) return;", tidak ada crash maupun galat -
      kasir restoran hanya kehilangan seluruh cara berpindah bill dan membuka
      bill baru, diam-diam.
    -->
    <include
        android:id="@+id/posBonRow"
        layout="@layout/view_pos_bon_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pos_space_4"
        android:layout_marginTop="@dimen/pos_space_4"
        android:layout_marginEnd="@dimen/pos_space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nativeHeader" />

    <!-- ===== Kolom kanan: keranjang permanen ===== -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/cartPaneContainer"
        android:layout_width="@dimen/cart_pane_width"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/posBonRow" />

    <!-- ===== Kolom kiri: daftar menu ===== -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomCategoryBar"
        app:layout_constraintEnd_toStartOf="@id/cartPaneContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/posBonRow" />

    <include
        layout="@layout/view_pos_category_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cartPaneContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      Wadah overlay global. Masih ada di tablet karena dipakai dialog dan
      layar tempel lain, bukan hanya keranjang.
    -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:translationZ="100dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
