<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar kasir - tablet (lebar terkecil >= 600dp).

  Berkas ini dulunya salinan byte-per-byte dari versi ponsel: tidak satu pun
  atributnya berbeda, sehingga tablet 10 inci menampilkan daftar menu selebar
  layar penuh dan keranjang tetap harus dibuka sebagai laci yang menutupi
  menu. Sekarang layarnya benar-benar dibagi dua - menu di kiri, keranjang
  menempel permanen di kanan - jadi kasir bisa menambah item dan melihat
  total pada saat yang sama.

  Dua akibat yang disengaja:

  1. Tidak ada tombol keranjang di bilah atas. Keranjang sudah selalu
     terlihat, jadi tombolnya hanya akan membuka laci di atas kolom yang
     memuat isi yang sama. MainActivity menjaga btnCart dan tvCartBadge
     dengan pemeriksaan null, jadi ketiadaannya di sini aman.
  2. Bilah kategori berhenti di tepi kolom keranjang, bukan di tepi layar.
     Kategori milik daftar menu; melebarkannya ke bawah keranjang membuat
     kolom keranjang seolah mengambang.

  Untuk modul retail dan bengkel, MainActivity.applyBusinessTypeUi()
  menyembunyikan kolom keranjang dan melebarkan fragmentContainer sampai tepi
  kanan: keduanya punya layar kasir sendiri yang sudah memuat keranjangnya.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clipToPadding="false">

    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_bar_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ===== Bilah atas ===== -->
    <androidx.cardview.widget.CardView
        android:id="@+id/nativeHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="@dimen/radius_surface"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="@dimen/pos_header_logo_size"
                    android:layout_height="@dimen/pos_header_logo_size"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="@string/cd_shop_logo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_logo_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pos_default_shop_name"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvShopAddress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/pos_default_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!--
                  Kolom cari duduk di baris yang sama dengan identitas toko:
                  tablet punya lebar berlebih, dan menumpuknya seperti pada
                  ponsel hanya membuang tinggi yang seharusnya jadi menu.
                -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="@dimen/radius_surface_sm"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="@dimen/pos_search_icon_size"
                            android:layout_height="@dimen/pos_search_icon_size"
                            android:contentDescription="@null"
                            android:src="@drawable/search_24"
                            app:tint="@color/text_tertiary" />

                        <EditText
                            android:id="@+id/tvSearchHint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:hint="@string/label_search"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:minHeight="@dimen/pos_search_min_height"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary"
                            android:textSize="15sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <ImageButton
                    android:id="@+id/btnBarcode"
                    android:layout_width="@dimen/topbar_icon_size"
                    android:layout_height="@dimen/topbar_icon_size"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip"
                    android:contentDescription="@string/cd_barcode_scan"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_barcode"
                    app:tint="@color/text_primary" />
            </LinearLayout>

            <include layout="@layout/view_pos_draft_row" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== Kolom kanan: keranjang permanen ===== -->

        <androidx.fragment.app.FragmentContainerView
        android:id="@+id/cartPaneContainer"
        android:layout_width="@dimen/cart_pane_width"
        android:layout_height="0dp"
        android:background="@color/surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nativeHeader" />

    <!-- ===== Kolom kiri: daftar menu ===== -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomCategoryBar"
        app:layout_constraintEnd_toStartOf="@id/cartPaneContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nativeHeader" />

    <include
        layout="@layout/view_pos_category_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/category_bar_margin"
        android:layout_marginEnd="@dimen/category_bar_margin"
        android:layout_marginBottom="@dimen/category_bar_margin"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cartPaneContainer"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
      Wadah overlay global. Masih ada di tablet karena dipakai dialog dan
      layar tempel lain, bukan hanya keranjang.
    -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:elevation="100dp"
        android:focusable="true"
        android:translationZ="100dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
