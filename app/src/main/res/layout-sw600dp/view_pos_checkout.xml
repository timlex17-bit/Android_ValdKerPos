<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel ringkasan + checkout kasir - varian tablet.

  Pada ponsel berkas dengan nama sama adalah bilah tipis di dasar layar.
  Di tablet, kasir dibagi dua kolom dan berkas ini mengisi seluruh kolom
  kanan. Versi sebelumnya memakai bilah ponsel apa adanya lalu mendorongnya
  ke dasar kolom dengan <Space android:layout_weight="1"/>, sehingga kolom
  selebar 360dp berisi ruang kosong 80% dengan satu tombol menggantung di
  bawah - itulah "berantakan" yang dilaporkan.

  Semua id yang dibaca RetailPOSFragment sama persis dengan varian ponsel:
  bottomBar (dipakai SystemBars.padBottom), txtGrandTotal, dan btnCheckout.
  Jadi tidak ada satu baris Java pun yang perlu tahu varian mana yang sedang
  di-inflate.
-->
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Valora.PanelCard"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_summary"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/stroke_soft" />

        <!--
          Ruang kosong ditaruh DI SINI, bukan di layout pemanggil: ringkasan
          menempel ke bawah panel supaya total selalu berada di dekat tombol
          yang ditekan kasir, berapa pun tinggi tabletnya.
        -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/label_total"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGrandTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:text="@string/amount_zero_usd"
            android:textColor="@color/brand_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="$1,284.50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckout"
            style="@style/Widget.Valora.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="46dp"
            android:text="@string/action_checkout"
            android:textSize="14sp"
            app:icon="@drawable/ic_bag"
            app:iconGravity="textStart"
            app:rippleColor="#33FFFFFF" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
