<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel total + bayar - TABLET, implementasi 4.

  Di ponsel blok ini adalah bilah melintang di dasar layar. Di tablet ia kolom
  penuh di sisi kanan, karena di sana ruangnya ada dan bilah melintang akan
  membuang seluruh tinggi layar untuk satu angka.

  Bentuknya mengikuti bahasa yang sama: kartu putih bersudut membulat di atas
  ground lavender, ikon berwarna sebagai penanda, dan tombol bayar yang mati
  terlihat sebelum ditekan.

  Id-nya sama persis dengan varian ponsel ditambah tiga yang hanya ada di
  sini - txtSummaryItemCount, posSummaryEmpty, posSummaryTotals - karena
  hanya kolom setinggi ini yang punya ruang untuk membedakan "keranjang
  kosong" dari "keranjang berisi" lewat dua blok terpisah. RetailPOSFragment
  memeriksa null untuk ketiganya, jadi ketiadaannya di ponsel bukan masalah.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_pos_card"
    android:orientation="vertical"
    android:padding="@dimen/pos_space_4">

    <TextView
        style="@style/TextAppearance.Pos.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/archivo_bold"
        android:text="@string/pos_total_label"
        android:textSize="12sp" />

    <!-- ══════ Keranjang kosong ══════ -->

    <LinearLayout
        android:id="@+id/posSummaryEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_pos_tile_accent_lg"
            android:contentDescription="@null"
            android:padding="15dp"
            android:src="@drawable/ic_pos_basket"
            app:tint="@color/pos_accent" />

        <TextView
            style="@style/TextAppearance.Pos.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pos_gap_sm"
            android:gravity="center"
            android:text="@string/pos_empty_title"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- ══════ Keranjang berisi ══════ -->

    <LinearLayout
        android:id="@+id/posSummaryTotals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtSummaryItemCount"
            style="@style/TextAppearance.Pos.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pos_pill_green"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:minHeight="26dp"
            android:paddingStart="@dimen/pos_gap_sm"
            android:paddingEnd="@dimen/pos_gap_sm"
            android:textColor="@color/pos_green_deep"
            android:textSize="11.5sp"
            app:drawableStartCompat="@drawable/ic_pos_basket"
            app:drawableTint="@color/pos_green_deep"
            tools:text="3 item" />

        <!--
          Angka total. autoSize, bukan ukuran tetap: kolom ini selebar 200dp
          pada tablet 600dp dan 320dp pada tablet 1400dp, sementara angkanya
          bisa mencapai enam digit. Ukuran tetap akan terpotong di ujung
          sempitnya.
        -->
        <TextView
            android:id="@+id/txtGrandTotal"
            style="@style/TextAppearance.Pos.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pos_space_2"
            android:autoSizeMaxTextSize="@dimen/pos_text_display"
            android:autoSizeMinTextSize="18sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:text="@string/amount_zero_usd"
            tools:text="$1,284.50" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckout"
        style="@style/Widget.Pos.MaterialPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pos_gap"
        android:text="@string/pos_pay"
        app:icon="@drawable/ic_pos_wallet"
        app:iconGravity="textStart"
        app:iconTint="@color/pos_on_accent" />

</LinearLayout>
