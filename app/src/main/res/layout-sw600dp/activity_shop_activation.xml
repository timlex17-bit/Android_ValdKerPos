<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar aktivasi perangkat - tablet.

  Susunannya sengaja kembar dengan layar masuk: dua panel, identitas di kiri
  dan kartu di kanan, dengan aksen tegak yang sama. Keduanya dilihat berurutan
  dalam hitungan detik, jadi perbedaan susunan apa pun akan terbaca seperti
  berpindah aplikasi.

  Kartunya view_activation_card.xml yang sama dengan varian ponsel; yang
  berbeda hanya tempat dan lebarnya.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootActivation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!--
      Aksen di tablet berdiri TEGAK di belakang panel kiri, bukan pita
      mendatar seperti di ponsel. Pita mendatar setinggi 260dp pada layar
      selebar 1280dp berhenti di tengah-tengah halaman dan membentuk garis
      yang tidak menandai apa pun - persis yang terlihat saat dirender.
    -->
    <View
        android:id="@+id/topAccent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/brand_tint_soft"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.46" />

    <!--
      Strip bilah status digambar SESUDAH aksen. Urutan di XML adalah
      urutan menggambar: waktu aksen tegak ditaruh belakangan, ia
      menutupi strip ungu di separuh kiri layar dan jam di sana
      berdiri di atas latar lavender - terlihat saat dirender.
    -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_bar_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center"
            android:minHeight="@dimen/login_pane_min_height"
            android:orientation="horizontal"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="32dp">

            <!-- ===== Panel kiri: identitas ===== -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="40dp"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="@dimen/login_logo_size"
                    android:layout_height="@dimen/login_logo_size"
                    android:background="@drawable/bg_login_logo"
                    android:gravity="center"
                    android:text="@string/login_logo_letter"
                    android:textColor="@color/text_on_brand"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/valora_ink"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:text="@string/activation_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- ===== Panel kanan: formulir ===== -->
            <include
                layout="@layout/view_activation_card"
                android:layout_width="@dimen/login_card_max_width"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
