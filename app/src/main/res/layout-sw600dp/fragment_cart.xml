<?xml version="1.0" encoding="utf-8"?>
<!--
  Keranjang kasir - varian tablet (kolom tetap di sisi kanan).

  Di tablet layar kasir dibagi dua: menu di kiri, keranjang di kanan dan
  selalu terlihat.

  DUA ID YANG SENGAJA TIDAK ADA DI SINI

  Dibanding layout/fragment_cart.xml (varian laci untuk ponsel), berkas ini
  dengan sengaja TIDAK memuat:

    - viewDim       latar redup. Tidak ada yang perlu diredupkan; kolom
                    keranjang berdiri sejajar dengan daftar menu, bukan
                    mengambang di atasnya.
    - btnCloseCart  tombol tutup. Kolomnya bagian tetap dari layar kasir dan
                    tidak pernah ditutup; tombol silang hanya akan
                    meninggalkan kolom kosong selebar 340dp.

  Ini aman karena CartFragment menjaga keduanya dengan pemeriksaan null:
  btnClose dipasangi listener hanya bila findViewById mengembalikan view, dan
  begitu pula latar redup. Jalur tutup laci sendiri sudah dimatikan lewat
  CartFragment.closeOverlaySafely(), yang langsung keluar dalam mode kolom -
  keranjang kolom tidak pernah didorong ke back stack, jadi popBackStack() di
  sana akan membuang entri milik layar lain.

  Jadi kalau lint mengeluh InconsistentLayout untuk pasangan berkas ini,
  itu memang keadaan yang dikehendaki. Jangan menyalin viewDim dan
  btnCloseCart ke sini untuk "menyamakan" kedua berkas. Semua id lain yang
  dibaca CartFragment memang sengaja sama persis di kedua varian.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <!--
      Kolom keranjang mengikuti bentuk kasir bengkel: isinya kartu panel di
      atas latar abu-abu, bukan satu bidang putih yang dipisah garis. Itu yang
      membuat kolom bengkel terlihat rapi - batas tiap bagian terbaca dari
      kartunya sendiri.
    -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Valora.PanelCard"
        android:id="@+id/cartRoot"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ===== Kepala ===== -->
        <LinearLayout
            android:id="@+id/cartHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCartTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_cart"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCartCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="3 items" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_soft" />

        <!--
          Meja dan pelayan dine-in. Hanya terlihat pada toko restoran yang
          modul "tables"/"waiters"-nya hidup; tiap tombol disembunyikan
          sendiri-sendiri karena kedua modul bisa menyala terpisah.
        -->
        <LinearLayout
            android:id="@+id/rowDineInAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickTable"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_surface_sm"
                app:strokeColor="@color/stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickWaiter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_surface_sm"
                app:strokeColor="@color/stroke" />
        </LinearLayout>

        <!-- ===== Isi ===== -->
        <FrameLayout
            android:id="@+id/cartContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_cart" />

            <LinearLayout
                android:id="@+id/tvCartEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:alpha="0.28"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shopping_cart"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/msg_cart_empty"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cart_empty_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Kaki: ringkasan + aksi ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/label_subtotal"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="26sp"
                    android:autoSizeMinTextSize="16sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/amount_zero_usd"
                    android:textColor="@color/brand_primary"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    tools:text="$128.45" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuePayment"
                style="@style/Widget.Valora.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="54dp"
                android:text="@string/cart_continue_payment"
                app:icon="@drawable/ic_bag"
                app:iconGravity="textStart"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelOrder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="44dp"
                android:text="@string/cart_cancel_order"
                android:textAllCaps="false"
                android:textColor="@color/state_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radius_surface_sm" />
        </LinearLayout>
    </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
