<?xml version="1.0" encoding="utf-8"?>
<!--
  POS kasir (retail) - tablet (lebar terkecil >= 600dp).

  Berkas ini dulunya salinan byte-per-byte dari versi potret: tidak satu pun
  atributnya berbeda, jadi ia hanya menggandakan pemeliharaan tanpa memberi
  apa pun kepada tablet. Sekarang benar-benar tata letak tablet - dua kolom
  permanen, daftar item lebar di kiri dan panel checkout tetap di kanan,
  sehingga kasir tidak perlu menggulir untuk melihat total.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRetailPos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <include layout="@layout/view_pos_topbar" />

    <include layout="@layout/view_pos_controls" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRetailWorkspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="14dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_surface"
            app:cardElevation="1dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <include layout="@layout/view_pos_list" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="@dimen/pos_side_panel_max_width"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include layout="@layout/view_pos_checkout" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
