<?xml version="1.0" encoding="utf-8"?>
<!--
  POS kasir (retail) - tablet.

  Dua kolom: daftar item bon di kiri, panel ringkasan + checkout di kanan.

  Yang diperbaiki dibanding versi sebelumnya:

  1. Kolom kanan tidak lagi berisi bilah ponsel yang didorong ke dasar dengan
     <Space android:layout_weight="1"/>. Kolomnya kini panel penuh - lihat
     layout-sw600dp/view_pos_checkout.xml - jadi ruang 360dp itu dipakai,
     bukan dibiarkan kosong dengan satu tombol menggantung di bawahnya.
  2. Lebar kolom kanan datang dari bucket lebar layar (values-w###dp), bukan
     dari values-sw600dp. Tablet 800dp dalam potret dan tablet yang sama
     dalam lanskap punya ruang yang jauh berbeda; smallest-width tidak bisa
     membedakannya dan memberi keduanya lebar yang sama.
  3. ConstraintLayout dengan batas min/max, bukan LinearLayout berbobot, jadi
     kolom kanan tidak pernah lebih sempit dari yang terbaca maupun melebar
     jadi kolom kosong pada tablet sangat lebar.

  Bilah atas dan panel kendali di-<include> dari berkas yang sama dengan
  varian ponsel, jadi chip bon dan kolom cari tidak bisa menyimpang antar
  varian.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRetailPos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <include layout="@layout/view_pos_topbar" />

    <include layout="@layout/view_pos_controls" />

    <!--
      Bilah luring. Menempati barisnya sendiri di bawah kendali kasir, jadi
      isi di bawahnya bergeser alih-alih tertutup - itulah bedanya dengan
      toast yang dulu melayang di atas bilah kategori. Tersembunyi sampai
      OfflineBanner menyatakan keadaannya berubah jadi luring.
    -->
    <include layout="@layout/view_offline_banner" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="18dp">

        <com.google.android.material.card.MaterialCardView

            style="@style/Widget.Valora.PanelCard"
            android:id="@+id/cardRetailWorkspace"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/panelRetailCheckout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <include layout="@layout/view_pos_list" />
        </com.google.android.material.card.MaterialCardView>

        <FrameLayout
            android:id="@+id/panelRetailCheckout"
            android:layout_width="@dimen/pos_side_panel_width"
            android:layout_height="0dp"
            android:minWidth="@dimen/pos_side_panel_min_width"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/pos_side_panel_max_width">

            <include layout="@layout/view_pos_checkout" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
