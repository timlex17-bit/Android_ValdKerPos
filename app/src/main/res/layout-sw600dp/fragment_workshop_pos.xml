<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootWorkshopPos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- LEFT CONTROL PANEL -->
    <ScrollView
        android:id="@+id/leftPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingEnd="10dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutItemsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.36">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWorkshopHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E9EDF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <!-- Brand Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="10dp"
                            android:backgroundTint="#1F2937"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:id="@+id/imgLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/cd_shop_logo"
                                android:scaleType="centerCrop"
                                android:src="@drawable/bg_logo_circle" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/tvBrand"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/workshop_default_title"
                                android:textColor="#0F172A"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                tools:text="Valora POS Workshop" />

                            <TextView
                                android:id="@+id/tvShopAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/workshop_default_address"
                                android:textColor="#98A2B3"
                                android:textSize="11sp"
                                tools:text="Becora, Dili" />
                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/chipAddDraft"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            app:cardBackgroundColor="#22C55E"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/draft_add"
                                android:textColor="#FFFFFF"
                                android:textSize="22sp"
                                android:textStyle="bold" />
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <!-- Draft Chips -->
                    <HorizontalScrollView
                        android:id="@+id/draftChipScroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:fillViewport="false"
                        android:overScrollMode="ifContentScrolls"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupDrafts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:chipSpacingVertical="0dp"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDraftA"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:checked="true"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:minHeight="48dp"
                                android:text="@string/draft_a_preview"
                                android:textColor="#166534"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:checkedIconVisible="false"
                                app:chipBackgroundColor="#DCFCE7"
                                app:chipCornerRadius="24dp"
                                app:chipMinHeight="48dp"
                                app:chipStrokeColor="#86EFAC"
                                app:chipStrokeWidth="1dp"
                                app:ensureMinTouchTargetSize="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDraftB"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:minHeight="48dp"
                                android:text="@string/draft_b_preview"
                                android:textColor="#334155"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:checkedIconVisible="false"
                                app:chipBackgroundColor="#FFFFFF"
                                app:chipCornerRadius="24dp"
                                app:chipMinHeight="48dp"
                                app:chipStrokeColor="#E2E8F0"
                                app:chipStrokeWidth="1dp"
                                app:ensureMinTouchTargetSize="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDraftC"
                                style="@style/Widget.MaterialComponents.Chip.Choice"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:minHeight="48dp"
                                android:text="@string/draft_walkin_preview"
                                android:textColor="#334155"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                app:checkedIconVisible="false"
                                app:chipBackgroundColor="#FFFFFF"
                                app:chipCornerRadius="24dp"
                                app:chipMinHeight="48dp"
                                app:chipStrokeColor="#E2E8F0"
                                app:chipStrokeWidth="1dp"
                                app:ensureMinTouchTargetSize="true" />

                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Customer -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/label_customer"
                                android:textAllCaps="true"
                                android:textColor="#B0B7C8"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtCustomerName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/workshop_walk_in_customer"
                                android:textColor="#0F172A"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                tools:text="Walk-in Customer" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSelectCustomer"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/action_change"
                            android:textAllCaps="false"
                            android:textColor="#16A34A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@android:color/transparent"
                            app:elevation="0dp"
                            app:rippleColor="#1122C55E" />
                    </LinearLayout>

                    <!-- Vehicle + Plate -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingEnd="6dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:backgroundTint="#E8F9EC"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/label_vehicle"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_car"
                                    app:tint="#34C759" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/txtVehicleName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/workshop_default_vehicle"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="Toyota Avanza" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="6dp">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:backgroundTint="#E8F9EC"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp"
                                app:strokeWidth="0dp">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/label_plate"
                                    android:padding="6dp"
                                    android:src="@drawable/ic_car"
                                    app:tint="#34C759" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/txtPlateNumber"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/workshop_default_plate"
                                android:textColor="#0F172A"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="D 0123 TL" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SUMMARY BOXES -->
            <LinearLayout
                android:id="@+id/layoutQuickStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ECFDF3"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D1FAE5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/label_service"
                            android:textColor="#0F172A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtServiceTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/amount_zero_usd"
                            android:textColor="#16A34A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="$40.99" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ECFDF3"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D1FAE5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/label_part"
                            android:textColor="#0F172A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPartsTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/amount_zero_usd"
                            android:textColor="#16A34A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="$40.99" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="#ECFDF3"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#D1FAE5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/label_product"
                            android:textColor="#0F172A"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtProductTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="@string/amount_zero_usd"
                            android:textColor="#16A34A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="$40.99" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- BOTTOM PANEL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/layoutBottomPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E8EEF5"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:id="@+id/layoutCheckoutSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:minHeight="60dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.15"
                            android:orientation="vertical"
                            android:paddingEnd="10dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/label_total"
                                android:textAllCaps="true"
                                android:textColor="#94A3B8"
                                android:textSize="10sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtGrandTotal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:autoSizeMaxTextSize="24sp"
                                android:autoSizeMinTextSize="15sp"
                                android:autoSizeStepGranularity="1sp"
                                android:autoSizeTextType="uniform"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:text="@string/amount_zero_usd"
                                android:textColor="#16A34A"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="$1,240.99" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCheckout"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="0.85"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="@string/action_checkout"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="#22C55E"
                            app:cornerRadius="18dp"
                            app:elevation="0dp"
                            app:rippleColor="#2222C55E" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutWorkshopActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddService"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/label_service"
                            android:textAllCaps="false"
                            android:textColor="#16A34A"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:backgroundTint="#ECFDF3"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_service"
                            app:iconGravity="textStart"
                            app:iconPadding="3dp"
                            app:iconSize="15dp"
                            app:iconTint="#16A34A"
                            app:strokeColor="#86EFAC"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddPart"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/label_part"
                            android:textAllCaps="false"
                            android:textColor="#16A34A"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:backgroundTint="#ECFDF3"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_shopping_cart"
                            app:iconGravity="textStart"
                            app:iconPadding="3dp"
                            app:iconSize="15dp"
                            app:iconTint="#16A34A"
                            app:strokeColor="#86EFAC"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddProduct"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:minWidth="48dp"
                            android:minHeight="48dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/label_product"
                            android:textAllCaps="false"
                            android:textColor="#16A34A"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:backgroundTint="#ECFDF3"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_bag"
                            app:iconGravity="textStart"
                            app:iconPadding="3dp"
                            app:iconSize="15dp"
                            app:iconTint="#16A34A"
                            app:strokeColor="#86EFAC"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- RIGHT ITEMS AREA -->
    <LinearLayout
        android:id="@+id/layoutItemsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtItemsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_items"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="1dp"
            app:strokeColor="#E8EEF5"
            app:strokeWidth="1dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWorkspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_product_list" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>