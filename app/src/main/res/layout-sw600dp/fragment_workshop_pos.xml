<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootWorkshopPos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingStart="6dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/leftPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/layoutItemsContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.42">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWorkshopHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#E9EDF5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="34dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="7dp"
                        android:backgroundTint="#1F2937"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/imgLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/cd_shop_logo"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_logo_circle" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="5dp">

                        <TextView
                            android:id="@+id/tvBrand"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/workshop_default_title"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="Valora POS Workshop" />

                        <TextView
                            android:id="@+id/tvShopAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/workshop_default_address"
                            android:textColor="#98A2B3"
                            android:textSize="9sp"
                            tools:text="Becora, Dili" />
                    </LinearLayout>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAddDraft"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:gravity="center"
                        android:minWidth="30dp"
                        android:text="@string/draft_add"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#22C55E"
                        app:chipCornerRadius="15dp"
                        app:chipMinHeight="30dp"
                        app:chipStrokeWidth="0dp"
                        app:ensureMinTouchTargetSize="false" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/draftChipScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDrafts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="4dp"
                        app:chipSpacingVertical="0dp"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDraftA"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:checked="true"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minHeight="30dp"
                            android:text="@string/draft_a_preview"
                            android:textColor="#166534"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="#DCFCE7"
                            app:chipCornerRadius="15dp"
                            app:chipMinHeight="30dp"
                            app:chipStrokeColor="#86EFAC"
                            app:chipStrokeWidth="1dp"
                            app:ensureMinTouchTargetSize="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDraftB"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minHeight="30dp"
                            android:text="@string/draft_b_preview"
                            android:textColor="#334155"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="#FFFFFF"
                            app:chipCornerRadius="15dp"
                            app:chipMinHeight="30dp"
                            app:chipStrokeColor="#E2E8F0"
                            app:chipStrokeWidth="1dp"
                            app:ensureMinTouchTargetSize="false" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDraftC"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minHeight="30dp"
                            android:text="@string/draft_walkin_preview"
                            android:textColor="#334155"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:checkedIconVisible="false"
                            app:chipBackgroundColor="#FFFFFF"
                            app:chipCornerRadius="15dp"
                            app:chipMinHeight="30dp"
                            app:chipStrokeColor="#E2E8F0"
                            app:chipStrokeWidth="1dp"
                            app:ensureMinTouchTargetSize="false" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/layoutWorkshopSummary"
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtWorkshopJobInfoLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_workshop_job_info"
                        android:textAllCaps="true"
                        android:textColor="#64748B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSelectCustomer"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="42dp"
                        android:minHeight="28dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/action_change"
                        android:textAllCaps="false"
                        android:textColor="#16A34A"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="@string/workshop_vehicle_not_selected"
                    android:textColor="#0F172A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Walk-in Customer • Veikulu belum dipilih" />

                <TextView
                    android:id="@+id/txtVehicleSummary"
                    android:layout_width="match_parent"
                    android:layout_height="19dp"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:text="@string/workshop_vehicle_not_selected"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="Veikulu: CAR - Toyota Hilux - B1234" />

                <TextView
                    android:id="@+id/txtWorkshopSummary"
                    android:layout_width="match_parent"
                    android:layout_height="19dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:visibility="gone"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/layoutWorkshopChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:visibility="gone"
                    app:chipSpacingHorizontal="4dp"
                    app:chipSpacingVertical="1dp"
                    app:singleLine="true"
                    tools:visibility="visible">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMechanicSummary"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="22dp"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        app:chipBackgroundColor="#F8FAFC"
                        app:chipCornerRadius="11dp"
                        app:chipMinHeight="22dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="Mekanik: Antonio" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipWorkOrderSummary"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="22dp"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        app:chipBackgroundColor="#F8FAFC"
                        app:chipCornerRadius="11dp"
                        app:chipMinHeight="22dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="WO: WO-001" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBookingSummary"
                        style="@style/Widget.MaterialComponents.Chip.Action"
                        android:layout_width="wrap_content"
                        android:layout_height="22dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="22dp"
                        android:textColor="#334155"
                        android:textSize="10sp"
                        app:chipBackgroundColor="#F8FAFC"
                        app:chipCornerRadius="11dp"
                        app:chipMinHeight="22dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false"
                        tools:text="Rezerva: BK-001" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/layoutQuickStats"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/txtServiceTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/amount_zero_usd"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="$40.99" />

            <TextView
                android:id="@+id/txtPartsTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/amount_zero_usd"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="$40.99" />

            <TextView
                android:id="@+id/txtProductTotal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/amount_zero_usd"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="$40.99" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutBottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#E8EEF5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="7dp">

                <LinearLayout
                    android:id="@+id/layoutCheckoutSummary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtGrandTotal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.15"
                        android:autoSizeMaxTextSize="20sp"
                        android:autoSizeMinTextSize="13sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:text="@string/amount_zero_usd"
                        android:textColor="#16A34A"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="$1,240.99" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckout"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="0.85"
                        android:ellipsize="end"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:maxLines="1"
                        android:minHeight="44dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="@string/action_checkout"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="#22C55E"
                        app:cornerRadius="14dp"
                        app:elevation="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutWorkshopActions"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPackage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:paddingStart="1dp"
                        android:paddingEnd="1dp"
                        android:text="@string/label_package"
                        android:textAllCaps="false"
                        android:textColor="#16A34A"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:backgroundTint="#ECFDF3"
                        app:cornerRadius="12dp"
                        app:strokeColor="#86EFAC"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddService"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:paddingStart="1dp"
                        android:paddingEnd="1dp"
                        android:text="@string/label_service"
                        android:textAllCaps="false"
                        android:textColor="#16A34A"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:backgroundTint="#ECFDF3"
                        app:cornerRadius="12dp"
                        app:strokeColor="#86EFAC"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddPart"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:paddingStart="1dp"
                        android:paddingEnd="1dp"
                        android:text="@string/label_part"
                        android:textAllCaps="false"
                        android:textColor="#16A34A"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:backgroundTint="#ECFDF3"
                        app:cornerRadius="12dp"
                        app:strokeColor="#86EFAC"
                        app:strokeWidth="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddProduct"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:paddingStart="1dp"
                        android:paddingEnd="1dp"
                        android:text="@string/label_product"
                        android:textAllCaps="false"
                        android:textColor="#16A34A"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        app:backgroundTint="#ECFDF3"
                        app:cornerRadius="12dp"
                        app:strokeColor="#86EFAC"
                        app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutItemsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtItemsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_workshop_cart_items"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp"
            app:strokeColor="#E8EEF5"
            app:strokeWidth="1dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerWorkspace"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical"
                tools:listitem="@layout/item_product_list" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
