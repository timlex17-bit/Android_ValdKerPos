<?xml version="1.0" encoding="utf-8"?>
<!--
  Gaya bersama untuk SEMUA popup: dialog formulir (yang muncul dari tombol
  "+"), dialog konfirmasi androidx, menu popup, dan toast dalam aplikasi.

  Satu aturan bentuk berlaku di seluruh berkas ini: @dimen/radius_dialog.
  Sebelumnya tiap dialog menuliskan sudutnya sendiri - 12, 16, 18, 20, 22,
  24, dan 28dp semuanya hadir sekaligus - sehingga dua popup yang terbuka
  dari layar yang sama tidak pernah terlihat bersaudara. Mengubah radius
  seluruh aplikasi kini berarti mengubah satu dimen.

  Susunan dialog tidak diubah - judul, kartu bagian, urutan kolom, dan letak
  tombol tetap seperti sekarang.
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ============ Bentuk ============ -->

    <style name="ShapeAppearance.Valora.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_dialog</item>
    </style>

    <!-- ============ Kolom isian ============ -->

    <style name="Widget.Valora.TextField"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_dialog</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_dialog</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_dialog</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_dialog</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/valora_accent</item>
        <item name="android:textColorHint">@color/valora_muted</item>
    </style>

    <!-- ============ Tombol dialog ============ -->

    <!--
      Kedua gaya ini WAJIB mewarisi varian .Dialog. Bilah tombol dialog
      menaruh tombolnya lewat <include>, dan layout_width/layout_height-nya
      hanya datang dari gaya - mewarisi Widget.Material3.Button biasa
      membuat inflate m3_alert_dialog gagal dengan
      "You must supply a layout_width attribute".
    -->
    <style name="Widget.Valora.Dialog.Button.Positive"
        parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="backgroundTint">@color/valora_accent</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="cornerRadius">@dimen/radius_dialog</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">96dp</item>
    </style>

    <style name="Widget.Valora.Dialog.Button.Negative"
        parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/valora_muted</item>
        <item name="cornerRadius">@dimen/radius_dialog</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!--
      Tombol sekunder di dalam badan dialog (mis. "Pilih Ikon"). Bawaannya
      memakai colorPrimary #6204BF, yang hanya 1,9:1 terhadap putih.
    -->
    <style name="Widget.Valora.Dialog.Button.Outlined"
        parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/valora_accent</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="cornerRadius">@dimen/radius_dialog</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!--
      Tombol utama di dalam badan dialog (mis. "Tambah Item"), dipakai layout
      yang perlu aksi penuh-lebar sendiri di luar bilah tombol dialog.
    -->
    <style name="Widget.Valora.Dialog.Button.Filled"
        parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/valora_accent</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="cornerRadius">@dimen/radius_dialog</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- ============ Dialog ============ -->

    <!--
      Sama seperti tombol: atribut ini memberi gaya pada TextView judul, jadi
      induknya harus gaya widget yang membawa layout_width/layout_height,
      bukan sekadar TextAppearance.
    -->
    <style name="MaterialAlertDialog.Valora.Title.Text"
        parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/valora_ink</item>
    </style>

    <style name="MaterialAlertDialog.Valora.Body.Text"
        parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="MaterialAlertDialog.Valora"
        parent="MaterialAlertDialog.Material3">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="backgroundTint">@color/valora_surface</item>
    </style>

    <style name="ThemeOverlay.Valora.Dialog"
        parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialog.Valora</item>
        <item name="materialAlertDialogTitleTextStyle">
            @style/MaterialAlertDialog.Valora.Title.Text</item>
        <item name="materialAlertDialogBodyTextStyle">
            @style/MaterialAlertDialog.Valora.Body.Text</item>
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.Valora.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.Valora.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.Valora.Dialog.Button.Negative</item>
        <!-- Kolom isian di dalam dialog ikut gaya yang sama. -->
        <item name="textInputStyle">@style/Widget.Valora.TextField</item>
        <item name="colorPrimary">@color/valora_accent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="dialogCornerRadius">@dimen/radius_dialog</item>
    </style>

    <!--
      Dialog konfirmasi androidx (AlertDialog.Builder). Induknya harus varian
      Dialog.Alert dari Material3 - ThemeOverlay.Material3.MaterialAlertDialog
      mengandaikan tata letak m3_alert_dialog milik MaterialAlertDialogBuilder
      dan tidak cocok dipasang sebagai alertDialogTheme.
    -->
    <style name="ThemeOverlay.Valora.Dialog.Alert"
        parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="colorPrimary">@color/valora_accent</item>
        <item name="dialogCornerRadius">@dimen/radius_dialog</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/radius_dialog</item>
        <item name="buttonBarPositiveButtonStyle">
            @style/Widget.Valora.Dialog.Button.Positive</item>
        <item name="buttonBarNegativeButtonStyle">
            @style/Widget.Valora.Dialog.Button.Negative</item>
        <item name="buttonBarNeutralButtonStyle">
            @style/Widget.Valora.Dialog.Button.Negative</item>
        <item name="textInputStyle">@style/Widget.Valora.TextField</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Valora.Dialog</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Valora.Dialog</item>
    </style>

    <!-- ============ Menu popup ============ -->

    <style name="Widget.Valora.PopupMenu"
        parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
    </style>

</resources>
