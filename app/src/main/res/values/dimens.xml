    <dimen name="pos_side_panel_min_width">260dp</dimen>
    <dimen name="pos_side_panel_max_width">300dp</dimen>
    <dimen name="cart_pane_width">300dp</dimen>

    <!--
      Ukuran kartu produk. Dulu tiga salinan berkas kartu (layout, -land,
      -sw600dp) berbeda hanya pada angka-angka ini, dan ketiganya sudah
      menyimpang - yang satu memakai 170dp mati, yang lain @dimen. Sekarang
      satu berkas kartu membaca token di bawah, jadi ukuran per layar diatur
      di sini saja.
    -->
    <dimen name="product_card_radius">16dp</dimen>
    <dimen name="product_card_margin">6dp</dimen>
    <dimen name="product_card_padding">12dp</dimen>
    <dimen name="product_name_text">15sp</dimen>
