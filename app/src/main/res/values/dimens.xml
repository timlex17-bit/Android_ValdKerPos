    <!--
      Radius tunggal untuk SEMUA popup: jendela dialog, kartu di dalamnya,
      kolom isian, tombol, menu popup, dan toast. Satu nilai supaya tidak ada
      lagi sudut 16/18/20/22/24dp yang berbeda-beda di tiap berkas.

      Nilainya 12dp, naik dari 3dp. Pada 3dp sudutnya nyaris siku: di layar
      besar sebuah kotak selebar 560dp dengan sudut 3dp terbaca seperti
      jendela sistem, bukan seperti permukaan aplikasi yang sama dengan kartu
      di belakangnya. Angka 12dp bukan dipilih karena enak dilihat saja - itu
      persis @dimen/card_panel_radius, radius panel dan kartu di layar. Jadi
      popup kini bersudut sama dengan permukaan yang ia tumpangi, dan
      mengubah keduanya berarti mengubah dua angka yang memang bersaudara.

      Tetap SATU nilai untuk semua ukuran layar. Radius adalah ciri bentuk,
      bukan ukuran: popup yang sama harus terlihat sama di ponsel dan tablet,
      dan yang menyesuaikan diri terhadap layar adalah lebarnya
      (@dimen/dialog_min_width) - bukan lengkung sudutnya.
    -->
    <dimen name="radius_dialog">12dp</dimen>

    <!--
      Radius permukaan aplikasi (kartu di layar, bilah, panel). Dipisah dari
      radius dialog supaya mengubah salah satunya tidak menyeret yang lain.
    -->
    <dimen name="radius_surface">14dp</dimen>
    <dimen name="radius_surface_sm">10dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Tinggi minimum bilah atas; dipakai semua layar agar seragam. -->
