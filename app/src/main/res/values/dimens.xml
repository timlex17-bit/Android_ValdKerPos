<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="workspace_screen_padding">12dp</dimen>
    <dimen name="workspace_section_gap">10dp</dimen>
    <dimen name="workspace_card_padding">14dp</dimen>
    <dimen name="workspace_card_radius">20dp</dimen>

    <dimen name="workspace_title_size">20sp</dimen>
    <dimen name="workspace_subtitle_size">12sp</dimen>
    <dimen name="workspace_chip_text_size">11sp</dimen>

    <dimen name="workspace_label_size">11sp</dimen>
    <dimen name="workspace_value_large_size">17sp</dimen>
    <dimen name="workspace_value_medium_size">15sp</dimen>

    <dimen name="workspace_summary_title_size">17sp</dimen>
    <dimen name="workspace_summary_text_size">14sp</dimen>
    <dimen name="workspace_total_label_size">16sp</dimen>
    <dimen name="workspace_total_value_size">20sp</dimen>

    <dimen name="workspace_button_small_text_size">12sp</dimen>
    <dimen name="workspace_action_text_size">13sp</dimen>
    <dimen name="workspace_checkout_text_size">15sp</dimen>

    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_sm">8dp</dimen>
    <dimen name="space_md">12dp</dimen>
    <dimen name="space_lg">16dp</dimen>
    <dimen name="space_xl">20dp</dimen>

    <dimen name="cart_drawer_max_width">420dp</dimen>
    <dimen name="dialog_card_max_width">560dp</dimen>
    <dimen name="dialog_checkout_max_height">620dp</dimen>
    <dimen name="dialog_scroll_max_height">420dp</dimen>
    <dimen name="dialog_list_height">180dp</dimen>
    <dimen name="scanner_card_max_width">420dp</dimen>
    <dimen name="scanner_card_max_height">560dp</dimen>
    <dimen name="scanner_frame_size">220dp</dimen>
    <dimen name="report_chart_height">220dp</dimen>
    <dimen name="product_card_image_height">170dp</dimen>


    <!--
      Radius tunggal untuk SEMUA popup: jendela dialog, kartu di dalamnya,
      kolom isian, tombol, menu popup, dan toast. Satu nilai supaya tidak ada
      lagi sudut 16/18/20/22/24dp yang berbeda-beda di tiap berkas.
    -->
    <dimen name="radius_dialog">3dp</dimen>

    <!--
      Radius permukaan aplikasi (kartu di layar, bilah, panel). Dipisah dari
      radius dialog supaya mengubah salah satunya tidak menyeret yang lain.
    -->
    <dimen name="radius_surface">14dp</dimen>
    <dimen name="radius_surface_sm">10dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- Tinggi minimum bilah atas; dipakai semua layar agar seragam. -->
    <dimen name="topbar_min_height">56dp</dimen>
    <dimen name="topbar_icon_size">40dp</dimen>
    <dimen name="touch_target_min">48dp</dimen>


    <!--
      Kasir dua kolom. cart_pane_width hanya terpakai pada tata letak tablet
      (layout-sw600dp/activity_main.xml); nilainya tetap didefinisikan di sini
      supaya rujukan dari layout mana pun tidak pernah gagal di-resolve.
    -->
    <dimen name="cart_thumb_size">52dp</dimen>
    <dimen name="cart_stepper_button">34dp</dimen>

    <!--
      Jarak FAB ke penghalang terdekat di bawah dan di sampingnya. Satu nilai
      untuk seluruh aplikasi; ValoraFab yang menghitung sisanya (inset bilah
      sistem) sendiri, jadi tidak ada lagi layar yang memakai angka ajaib.
    -->
    <dimen name="fab_margin">16dp</dimen>
    <!--
      Lebar panel samping kasir. Nilai sesungguhnya datang dari bucket
      values-w###dp; yang di sini hanya cadangan untuk layar sempit, tempat
      tata letak dua kolom memang tidak dipakai.
    -->
    <dimen name="pos_side_panel_width">280dp</dimen>
    <dimen name="pos_side_panel_min_width">260dp</dimen>
    <dimen name="pos_side_panel_max_width">300dp</dimen>
    <dimen name="cart_pane_width">300dp</dimen>

    <!--
      Ukuran kartu produk. Dulu tiga salinan berkas kartu (layout, -land,
      -sw600dp) berbeda hanya pada angka-angka ini, dan ketiganya sudah
      menyimpang - yang satu memakai 170dp mati, yang lain @dimen. Sekarang
      satu berkas kartu membaca token di bawah, jadi ukuran per layar diatur
      di sini saja.
    -->
    <dimen name="product_card_radius">16dp</dimen>
    <dimen name="product_card_margin">6dp</dimen>
    <dimen name="product_card_padding">12dp</dimen>
    <dimen name="product_name_text">15sp</dimen>
    <dimen name="product_meta_text">12sp</dimen>
    <dimen name="product_price_text">18sp</dimen>
    <dimen name="product_action_height">44dp</dimen>
    <dimen name="product_thumb_size">56dp</dimen>
    <!--
      Lebar minimum satu kartu produk. Jumlah kolom grid dihitung dari lebar
      daftar dibagi angka ini. Sempat 168dp: pada tablet 1280dp dengan kolom
      keranjang, hasilnya lima kolom selebar 170dp - cukup sempit sehingga
      label tombol terlipat tiga baris dan terpotong di tengah kata.
    -->
    <dimen name="product_card_min_width">180dp</dimen>
    <!--
      Lebar minimum jendela dialog. Di tablet, dialog bawaan Material hanya
      memakai sekitar 520dp dari layar 1280dp, sehingga popup pembayaran
      dengan lima kartu bagian harus digulir padahal ruangnya berlimpah.
    -->
    <dimen name="dialog_min_width">300dp</dimen>

    <!--
      Radius kartu, diambil dari kasir bengkel - satu-satunya layar yang sudah
      rapi. Panel/wadah 12dp, kartu item 16dp. Dipakai lewat
      @style/Widget.Valora.PanelCard dan Widget.Valora.ItemCard supaya retail,
      restoran, dan bengkel benar-benar memakai angka yang sama.
    -->
    <dimen name="card_panel_radius">12dp</dimen>
    <dimen name="card_item_radius">16dp</dimen>
    <dimen name="card_item_gap">6dp</dimen>
    <dimen name="card_item_padding">12dp</dimen>
    <!--
      Baris item kasir (yang dipindai / keranjang). Sengaja lebih padat dari
      kartu menu restoran: kartu menu berisi foto dan dilihat dari jarak
      pandang, sedangkan baris kasir dibaca dari dekat dan yang penting
      berapa banyak yang muat di layar.
    -->
    <dimen name="row_card_padding">8dp</dimen>
    <dimen name="row_card_margin">3dp</dimen>
    <dimen name="row_thumb_size">36dp</dimen>
    <dimen name="row_name_text">13sp</dimen>
    <dimen name="row_meta_text">11sp</dimen>
    <dimen name="row_price_text">14sp</dimen>
    <dimen name="row_stepper_button">28dp</dimen>
    <!-- Tombol tambah bundar di kartu menu restoran. -->
    <dimen name="product_action_size">36dp</dimen>
    <!--
      Bilah kategori di dasar layar kasir. Dipendekkan: bilah ini duduk tepat
      di bawah daftar menu, jadi setiap dp yang dipakainya diambil dari menu.
      Chipnya dulu setinggi 44dp (52dp di tablet) dengan ikon 28dp di dalam
      kotak - lebih besar daripada yang dibutuhkan untuk teks satu baris.
    -->
    <dimen name="category_chip_height">34dp</dimen>
    <dimen name="category_chip_min_width">0dp</dimen>
    <dimen name="category_chip_padding">10dp</dimen>
    <dimen name="category_chip_gap">6dp</dimen>
    <dimen name="category_chip_icon_box">22dp</dimen>
    <dimen name="category_chip_icon">16dp</dimen>
    <dimen name="category_chip_text">12sp</dimen>
    <dimen name="category_bar_min_height">46dp</dimen>
    <dimen name="category_bar_margin">14dp</dimen>
    <dimen name="category_bar_padding">6dp</dimen>
</resources>
