    <dimen name="topbar_icon_size">40dp</dimen>
    <dimen name="touch_target_min">48dp</dimen>

    <!--
      Kasir dua kolom. cart_pane_width hanya terpakai pada tata letak tablet
      (layout-sw600dp/activity_main.xml); nilainya tetap didefinisikan di sini
      supaya rujukan dari layout mana pun tidak pernah gagal di-resolve.
    -->
    <dimen name="cart_thumb_size">52dp</dimen>
    <dimen name="cart_stepper_button">34dp</dimen>

    <!--
