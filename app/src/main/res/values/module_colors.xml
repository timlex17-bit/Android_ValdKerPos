<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu warna aksen per modul dashboard. Warnanya dikelompokkan menurut
  domain - penjualan biru-nila, katalog ungu, orang toska, pembelian kuning,
  uang hijau, retur merah, gudang biru-sian, bengkel merah muda - supaya
  modul yang bersaudara terlihat bersaudara tanpa dua tile pun kembar warna.

  Tile memakai warna ini dua kali: penuh untuk ikonnya, dan versi sangat
  pucat (dihitung di DashboardAdapter) untuk kotak di belakang ikon.
-->
<resources>
