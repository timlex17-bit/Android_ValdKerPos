<?xml version="1.0" encoding="utf-8"?>
<!--
  Gaya widget yang dipakai lintas layar. Semua yang ada di sini dulunya
  ditulis ulang atribut demi atribut di setiap layout - chip filter saja
  muncul dalam empat ejaan berbeda - sehingga satu chip terlihat lebih tinggi
  dari tetangganya tergantung layar mana yang memuatnya.
-->
<resources>

    <!-- ============ Chip filter ============ -->

    <style name="Widget.Valora.FilterChip"
        parent="Widget.Material3.Chip.Filter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="chipMinHeight">34dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="chipCornerRadius">@dimen/radius_pill</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/chip_filter_stroke</item>
        <item name="chipBackgroundColor">@color/chip_filter_bg</item>
        <item name="android:textColor">@color/chip_filter_text</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- ============ Kartu daftar ============ -->

    <style name="Widget.Valora.ListCard"
        parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="rippleColor">@color/brand_tint</item>
    </style>

    <!-- ============ Lencana status ============ -->

    <style name="TextAppearance.Valora.Badge" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_on_brand</item>
    </style>


    <!-- ============ Tombol aksi utama layar ============ -->

    <!--
      Tombol utama di bilah bawah (checkout, sinkron, finalisasi, cetak).
      Warnanya datang dari selector supaya keadaan nonaktif tetap terbaca -
      lihat color/btn_primary_bg.xml.
    -->
    <style name="Widget.Valora.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">@dimen/touch_target_min</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/btn_primary_bg</item>
        <item name="android:textColor">@color/btn_primary_text</item>
        <item name="iconTint">@color/btn_primary_text</item>
        <item name="cornerRadius">@dimen/radius_surface_sm</item>
        <item name="elevation">0dp</item>
    </style>


    <!-- ============ Tombol tambah mengambang ============ -->

    <!--
      Satu tampilan untuk semua FAB. Sebelumnya empat belas layar menuliskan
      "#6204BF" sendiri dan memakai @android:drawable/ic_input_add - ikon
      bawaan sistem, yang bentuknya berbeda di tiap OEM, sehingga tombol yang
      sama terlihat lain di tiap perangkat.
    -->
    <style name="Widget.Valora.Fab" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_margin">@dimen/fab_margin</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="tint">@color/text_on_brand</item>
        <item name="srcCompat">@drawable/ic_add</item>
        <item name="elevation">6dp</item>
    </style>

    <!-- ============ Kartu ============ -->

    <!--
      Resep kartu kasir bengkel, dijadikan gaya bersama. Bengkel adalah layar
      yang paling rapi menurut pemilik, dan yang membuatnya rapi bukan warna
      melainkan konsistensi: setiap wadah adalah kartu putih bergaris rambut
      dengan sudut 12dp dan bayangan nyaris nol, dan setiap baris item adalah
      kartu tersendiri bersudut 16dp - bukan baris polos yang dipisah garis.

      Retail dan restoran dulu memakai campuran: kartu produk berbayang 2dp,
      baris keranjang tanpa kartu sama sekali, panel bersudut 14dp. Sekarang
      ketiga modul menunjuk dua gaya di bawah ini.
    -->
    <style name="Widget.Valora.PanelCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_panel_radius</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Valora.ItemCard" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">@dimen/card_item_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/brand_tint</item>
    </style>

    <!--
      ============ TOMBOL AKSI BARIS: EDIT DAN HAPUS ============

      Satu pola untuk seluruh aplikasi, dan polanya adalah KATA, bukan ikon.

      Sebelum ini ada lima pola berbeda untuk dua aksi yang sama: ImageButton
      berikon pensil/tong sampah bawaan Android (pelanggan, pemasok, kategori,
      satuan, rekening bank), MaterialButton yang hanya berikon (kelola
      produk), ImageView berikon tong sampah (draft hitung stok), TextView
      berlatar drawable dengan teks (gudang, stok gudang, transfer stok), dan
      Button polos bertema bawaan (mekanik, paket servis, modul bengkel). Dua
      di antaranya bahkan menuliskan "Edit" dan "Delete" langsung di layout,
      jadi keduanya tidak pernah ikut diterjemahkan.

      Ikon pensil dan tong sampah dibuang seluruhnya. Alasannya bukan selera:
      ikon bawaan Android itu abu-abu kecil tanpa label, dan pada tablet yang
      dipegang jauh dari mata - dipakai bergantian beberapa orang, sebagian
      baru - "pensil" dan "tong sampah" terlihat mirip pada ukuran 24dp.
      Menghapus data pelanggan tidak boleh bergantung pada tebakan bentuk.
      Kata "Hapus" tidak bisa salah baca, dan warnanya (merah) menguatkan,
      bukan menggantikan, maknanya.

      Ukurannya token, jadi tablet mendapat tombol lebih lega tanpa satu pun
      berkas layout yang perlu tahu ukuran layar.
    -->
    <style name="Widget.Valora.RowAction" parent="Widget.Material3.Button.TextButton">
        <!--
          Satu baris, selalu. Tanpa ini MaterialButton melipat labelnya begitu
          lebarnya sempit - "Delete" jadi "Del" di atas dan "ete" di bawah -
          dan tombol yang terlipat menjadi lebih tinggi daripada tetangganya,
          sehingga sepasang tombol Edit/Hapus berhenti sejajar. Terukur di
          ponsel pemilik: Edit 57x40dp, Delete 57x45dp.
        -->
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">@dimen/row_action_min_height</item>
        <item name="android:paddingStart">@dimen/row_action_padding_h</item>
        <item name="android:paddingEnd">@dimen/row_action_padding_h</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">@dimen/row_action_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_surface_sm</item>
    </style>

    <style name="Widget.Valora.RowAction.Edit">
        <item name="android:textColor">@color/state_info</item>
        <item name="backgroundTint">@color/row_action_edit_bg</item>
        <item name="rippleColor">@color/state_info</item>
    </style>

    <style name="Widget.Valora.RowAction.Delete">
        <item name="android:textColor">@color/state_danger</item>
        <item name="backgroundTint">@color/row_action_delete_bg</item>
        <item name="rippleColor">@color/state_danger</item>
    </style>

    <!--
      Varian padat: dipakai saat kedua tombol berbagi lebar kartu (weight 1
      masing-masing), bukan melebar sesuai isinya.

      Di kartu produk pada grid dua kolom, satu tombol hanya kebagian sekitar
      57dp pada ponsel 360dp - dan 32dp di antaranya habis oleh padding gaya
      dasarnya, menyisakan 25dp untuk kata "Delete" yang butuh sekitar 40dp.
      Karena itu paddingnya dipersempit DAN ukuran hurufnya dibuat menyusut
      sendiri: pada lebar yang tidak mungkin memuat kata utuh, yang mengalah
      adalah ukuran huruf, bukan kata yang terpotong jadi "Del...". Batas
      bawahnya 10sp supaya tidak pernah menyusut sampai tak terbaca.
    -->
    <style name="Widget.Valora.RowAction.Edit.Compact">
        <item name="android:paddingStart">@dimen/row_action_padding_compact</item>
        <item name="android:paddingEnd">@dimen/row_action_padding_compact</item>
        <!--
          Atribut AppCompat, bukan android:*. Yang versi framework baru ada di
          API 26, sementara aplikasi ini melayani sampai API 24; AppCompat
          menyediakan perilaku yang sama sejak API 14 lewat AppCompatButton -
          induk MaterialButton.
        -->
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">@dimen/row_action_text</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="Widget.Valora.RowAction.Delete.Compact">
        <item name="android:paddingStart">@dimen/row_action_padding_compact</item>
        <item name="android:paddingEnd">@dimen/row_action_padding_compact</item>
        <!--
          Atribut AppCompat, bukan android:*. Yang versi framework baru ada di
          API 26, sementara aplikasi ini melayani sampai API 24; AppCompat
          menyediakan perilaku yang sama sejak API 14 lewat AppCompatButton -
          induk MaterialButton.
        -->
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">10sp</item>
        <item name="autoSizeMaxTextSize">@dimen/row_action_text</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>
</resources>
