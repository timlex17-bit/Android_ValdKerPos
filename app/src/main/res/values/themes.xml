<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Satu tema untuk seluruh aplikasi.

      Isinya sengaja ditaruh di Theme.ValdKer.Base supaya varian malam
      (values-night) cukup mewarisi, bukan menyalin. Sebelumnya values-night
      memuat salinan penuh yang sudah ketinggalan: di sana tidak ada
      materialAlertDialogTheme maupun textInputStyle, jadi begitu perangkat
      memakai mode gelap semua dialog formulir kehilangan gaya bersamanya
      dan kembali ke tampilan bawaan Material.
    -->
    <style name="Theme.ValdKer.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!--
          targetSdk 36 membuat android:statusBarColor tidak berlaku lagi di
          Android 15+; yang terlihat di balik bilah status adalah layout layar
          itu sendiri. Nilai ini tetap ditulis untuk Android 14 ke bawah, dan
          setiap layar memanggil SystemBars.applyBrandTopBar() agar bilah atas
          ungunya membentang sampai ke belakang bilah status di semua versi.
        -->
        <item name="android:statusBarColor">@color/status_bar_brand</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Satu sumber untuk tampilan semua dialog formulir. -->
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Valora.Dialog</item>
        <!--
          AlertDialog dari androidx (dipakai puluhan kali untuk konfirmasi
          hapus, pilih opsi, dsb.) tidak membaca materialAlertDialogTheme -
          hanya alertDialogTheme. Tanpa baris ini dialog konfirmasi tampil
          dengan sudut dan tombol bawaan AppCompat, berbeda dari dialog
          formulir di layar yang sama.
        -->
        <item name="alertDialogTheme">@style/ThemeOverlay.Valora.Dialog.Alert</item>
        <item name="textInputStyle">@style/Widget.Valora.TextField</item>

        <!-- Radius jendela dialog untuk API 28+ dan untuk AppCompat. -->
        <item name="dialogCornerRadius">@dimen/radius_dialog</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/radius_dialog</item>

        <!-- Menu popup (overflow, spinner) ikut radius yang sama. -->
        <item name="popupMenuStyle">@style/Widget.Valora.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Valora.PopupMenu</item>
        <item name="materialAlertDialogBodyTextStyle">
            @style/MaterialAlertDialog.Valora.Body.Text</item>
    </style>

    <style name="Theme.ValdKer" parent="Theme.ValdKer.Base" />

</resources>
