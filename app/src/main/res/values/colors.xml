<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Warna merek aplikasi. Ungu #6204BF mencapai kontras 9,17:1 terhadap
      putih, jadi satu nilai ini aman dipakai sekaligus sebagai latar tombol
      (teks putih di atasnya) dan sebagai warna teks di atas putih. Hijau
      lama tidak bisa begitu: #60E66C hanya 1,9:1, sehingga dulu perlu nada
      gelap terpisah hanya agar label tombol terbaca.

      status_bar_brand dipisah namanya karena dipakai untuk bilah sistem,
      yang mungkin perlu berbeda dari warna tombol di kemudian hari.
    -->
    <color name="brand_primary">#6204BF</color>
    <color name="brand_primary_dark">#50039B</color>
    <color name="status_bar_brand">#6204BF</color>

    <!--
      Nada terang dari ungu merek, dipakai ujung gradasi di kepala layar
      masuk dan aktivasi. Hanya untuk latar besar: kontrasnya terhadap putih
      2,9:1, cukup untuk bidang warna tetapi tidak untuk teks kecil.
    -->
    <color name="brand_primary_bright">#8A34E0</color>

    <!--
      Putih transparan untuk isi yang berdiri DI ATAS ungu merek. Dipakai
      teks pendukung dan kotak logo di kepala layar masuk. Ditulis sebagai
      alpha, bukan sebagai ungu muda tetap, supaya ikut benar kalau nada
      gradasinya kelak diubah.
    -->
    <color name="text_on_brand_soft">#B8FFFFFF</color>
    <color name="brand_overlay_soft">#26FFFFFF</color>
    <color name="brand_overlay_stroke">#47FFFFFF</color>

    <!-- Dipakai gaya dialog bersama; lihat values/styles_dialog.xml. -->
    <color name="valora_accent">@color/brand_primary</color>
    <color name="valora_ink">#0F172A</color>
    <!-- Enam dialog formulir sudah memakai nada ini untuk badannya; jendela
         dialog ikut memakainya supaya tidak ada seam di bilah tombol. -->
    <color name="valora_surface">#F9FAFB</color>
    <color name="valora_muted">#64748B</color>

    <!--
      Palet semantik. Sebelum ini hampir setiap layout menuliskan hex sendiri
      (#111827, #6B7280, #E5E7EB, ...), sehingga satu nada muncul dalam lima
      ejaan berbeda dan tidak mungkin diubah serentak. Nama di bawah ini yang
      dipakai layout baru; nilainya tetap nada yang sudah dominan di aplikasi.
    -->
    <color name="app_bg">#F4F6FA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_subtle">#F8FAFC</color>
    <color name="stroke">#E5E7EB</color>
    <color name="stroke_soft">#EEF2F7</color>

    <color name="text_primary">#111827</color>
    <color name="text_secondary">#64748B</color>
    <color name="text_tertiary">#94A3B8</color>
    <color name="text_on_brand">#FFFFFF</color>

    <color name="brand_tint">#EBD9FD</color>
    <color name="brand_on_tint">#3C0375</color>

    <color name="state_danger">#DC2626</color>
    <color name="state_danger_strong">#B91C1C</color>
    <color name="state_danger_tint">#FEE2E2</color>
    <color name="state_warning">#B45309</color>
    <color name="state_warning_tint">#FEF3C7</color>
    <color name="state_review">#C2410C</color>
    <color name="state_review_tint">#FFEDD5</color>
    <color name="state_info">#2563EB</color>
    <color name="state_info_tint">#DBEAFE</color>
    <color name="state_success">#15803D</color>
    <color name="state_success_tint">#DCFCE7</color>

    <!--
      Dua nada ungu pendukung yang sudah dipakai belasan layout sebagai hex:
      latar sangat muda untuk blok bertanda merek, dan garis tepi untuk chip
      terpilih. Diberi nama supaya ikut berubah saat warna merek diganti.
    -->
    <color name="brand_tint_soft">#F5ECFE</color>
    <color name="brand_stroke">#BB80F4</color>

    <!-- Nada netral tambahan yang dipakai ikon dan pembatas. -->
    <color name="icon_muted">#374151</color>
    <color name="stroke_strong">#D1D5DB</color>

    <!--
      Latar tombol aksi baris (Edit / Hapus). Nilainya diambil apa adanya dari
      drawable bg_button_edit dan bg_button_delete yang dulu dipakai tiga
      modul, supaya warnanya tidak berubah saat polanya disatukan.
    -->
    <color name="row_action_edit_bg">#EEF2FF</color>
    <color name="row_action_delete_bg">#FEE2E2</color>

    <!--
      Lencana arah pada baris buku besar bank: MASUK / KELUAR / lainnya.
      Nilainya diambil apa adanya dari BankLedgerAdapter, tempat keenam warna
      ini dulu ditulis sebagai hex di dalam kode - jadi memindahkannya ke sini
      tidak mengubah satu piksel warna pun, hanya memberinya nama dan satu
      tempat tinggal.
    -->
    <color name="ledger_in_tint">#EBD9FD</color>
    <color name="ledger_in_text">#6204BF</color>
    <color name="ledger_out_tint">#FFEDD5</color>
    <color name="ledger_out_text">#C2410C</color>
    <color name="ledger_neutral_tint">#E5E7EB</color>
    <color name="ledger_neutral_text">#374151</color>

</resources>
