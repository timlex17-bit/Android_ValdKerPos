<?xml version="1.0" encoding="utf-8"?>
<!--
  Tombol bayar. Keadaan mati terlihat SEBELUM ditekan: keranjang kosong
  membuatnya abu, bukan ungu pucat, sehingga kasir tidak menekannya dan
  menunggu sesuatu terjadi.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_disabled_bg" />
            <corners android:radius="@dimen/pos_radius_field" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_accent_pressed" />
            <corners android:radius="@dimen/pos_radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_accent" />
            <corners android:radius="@dimen/pos_radius_field" />
        </shape>
    </item>
</selector>
