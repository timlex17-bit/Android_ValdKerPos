<?xml version="1.0" encoding="utf-8"?>
<!-- Baris yang bisa ditekan di dalam lembar Troka. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pos_neutral_200">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="@dimen/pos_radius_field" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_ground" />
            <corners android:radius="@dimen/pos_radius_field" />
        </shape>
    </item>
</ripple>
