<?xml version="1.0" encoding="utf-8"?>
<!--
  Latar kolom isian polos (EditText tanpa TextInputLayout) di dalam dialog.
  Terpisah dari bg_input karena bg_input juga dipakai layar biasa, yang
  radiusnya bukan radius popup.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/radius_dialog" />
    <stroke
        android:width="1dp"
        android:color="@color/stroke" />
</shape>
