<?xml version="1.0" encoding="utf-8"?>
<!--
  Formulir aktivasi: satu kolom kode toko, satu tombol.

  Seperti view_login_card.xml, akarnya bukan kartu melainkan isi polos: ia
  duduk di dalam lembar putih milik activity_shop_activation.xml, dan kartu
  di dalam kartu hanya menggambar garis kedua yang tidak memisahkan apa pun.
  Lebarnya diatur tag <include> pemanggil, karena atribut layout_* pada akar
  berkas yang disertakan selalu kalah oleh tag include.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:text="@string/activation_step"
        android:textColor="@color/brand_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:text="@string/activation_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/login_title_text"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/activation_message"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilShopCode"
        style="@style/Widget.Valora.TextField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="@string/login_shop_code">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etShopCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="organizationName"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:minHeight="@dimen/login_field_min_height"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="VLDK7A" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnActivate"
        style="@style/Widget.Valora.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:minHeight="@dimen/login_action_min_height"
        android:text="@string/activation_continue"
        android:textSize="15sp" />

    <!--
      Alamat server ada di sini, bukan hanya di layar masuk: pemasangan ke
      server sendiri diputuskan pada saat yang sama dengan kode toko, dan
      kalau alamatnya salah maka kode toko apa pun akan terlihat "salah"
      nanti.
    -->
    <LinearLayout
        android:id="@+id/btnToggleAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="@dimen/touch_target_min"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/login_advanced"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgAdvancedChevron"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/text_tertiary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Valora.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/login_server_url">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:maxLines="1"
                android:minHeight="@dimen/login_field_min_height"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

</LinearLayout>
