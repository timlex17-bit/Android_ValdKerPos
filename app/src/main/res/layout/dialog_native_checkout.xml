<?xml version="1.0" encoding="utf-8"?>
<!--
  Popup pembayaran kasir.

  Versi lama adalah satu kolom berisi 18 kolom isian polos dan lima Spinner
  bawaan yang berdiri langsung di atas latar dialog, tanpa pengelompokan:
  diskon, pelanggan, metode bayar, rekening bank, pembayaran terbagi, dan
  detail pesanan semuanya terlihat sama penting, dan angka total tenggelam
  sebagai teks 22sp di paling atas. Sekarang isinya dipecah jadi kartu per
  bagian dengan satu kartu total yang menonjol di kepala.

  Dua hal yang perlu dijaga saat menyunting berkas ini:

  1. Radius setiap kartu dan kolom isian memakai @dimen/radius_dialog - satu
     nilai untuk seluruh popup aplikasi, sama seperti dialog formulir lain.
  2. Kolom yang hanya muncul untuk kondisi tertentu (tunai, rekening bank,
     nomor meja, pengantaran) dibungkus wadah ber-id. Yang disembunyikan
     NativeCheckoutDialogFragment adalah wadahnya, bukan EditText di
     dalamnya: menyembunyikan EditText saja akan meninggalkan kotak
     TextInputLayout kosong yang tetap memakan ruang.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp">

        <!-- ===== Total ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/brand_tint"
            app:cardCornerRadius="@dimen/radius_dialog"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.08"
                    android:text="@string/checkout_total_due"
                    android:textAllCaps="true"
                    android:textColor="@color/brand_on_tint"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoSizeMaxTextSize="30sp"
                    android:autoSizeMinTextSize="18sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_zero_usd"
                    android:textColor="@color/brand_on_tint"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTotalBreakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/brand_on_tint"
                    android:textSize="@dimen/checkout_label_text"
                    android:visibility="gone"
                    tools:text="Subtotal $10.00  -  Tax 11% $1.10"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Diskon dan pelanggan ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_dialog"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvDiscountLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_discount_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/checkout_label_text"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilDiscountValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/checkout_discount_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDiscountValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!--
                      match_parent, bukan wrap_content: di LinearLayout
                      mendatar yang tingginya wrap_content, anak ber-
                      match_parent mendapat tinggi anak tertinggi - yaitu
                      kolom nominal di sebelahnya. Itulah yang membuat kotak
                      "$" ini benar-benar sejajar dengannya, bukan kira-kira
                      sejajar lewat angka tinggi yang disamakan dengan tangan
                      dan menyimpang begitu ukuran huruf sistem berubah.
                    -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_dialog_input"
                        android:minHeight="@dimen/checkout_field_min_height">

                        <Spinner
                            android:id="@+id/spDiscountMode"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:background="@null"
                            android:minWidth="@dimen/checkout_discount_mode_min_width"
                            android:paddingStart="12dp"
                            android:paddingEnd="30dp" />

                        <ImageView
                            android:layout_width="@dimen/checkout_field_icon_size"
                            android:layout_height="@dimen/checkout_field_icon_size"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/text_tertiary" />
                    </FrameLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCustomerLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_customer"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/checkout_label_text"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:minHeight="@dimen/checkout_field_min_height">

                    <Spinner
                        android:id="@+id/spCustomer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="34dp" />

                    <ImageView
                        android:layout_width="@dimen/checkout_field_icon_size"
                        android:layout_height="@dimen/checkout_field_icon_size"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_tertiary" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvCustomerPointsInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/brand_tint"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/checkout_points_zero"
                    android:textColor="@color/brand_on_tint"
                    android:textSize="@dimen/checkout_label_text"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Pembayaran ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_dialog"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvPaymentMethodLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_payment_method"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/checkout_label_text"
                    android:textStyle="bold" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_dialog_input"
                    android:minHeight="@dimen/checkout_field_min_height">

                    <Spinner
                        android:id="@+id/spPaymentMethod"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center_vertical"
                        android:background="@null"
                        android:paddingStart="12dp"
                        android:paddingEnd="34dp" />

                    <ImageView
                        android:layout_width="@dimen/checkout_field_icon_size"
                        android:layout_height="@dimen/checkout_field_icon_size"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="@color/text_tertiary" />
                </FrameLayout>

                <!-- Tunai: nominal diterima + kembalian. -->
                <LinearLayout
                    android:id="@+id/groupCash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCashReceived"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_cash_received">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCashReceived"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvChange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_dialog_input"
                        android:backgroundTint="@color/surface_subtle"
                        android:padding="10dp"
                        android:text="@string/checkout_change_zero"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Change: $4.50" />
                </LinearLayout>

                <!-- Metode non-tunai yang butuh rekening bank. -->
                <LinearLayout
                    android:id="@+id/groupBank"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/tvBankLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/label_bank_account"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/checkout_label_text"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_dialog_input"
                        android:minHeight="@dimen/checkout_field_min_height">

                        <Spinner
                            android:id="@+id/spBankAccount"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center_vertical"
                            android:background="@null"
                            android:paddingStart="12dp"
                            android:paddingEnd="34dp" />

                        <ImageView
                            android:layout_width="@dimen/checkout_field_icon_size"
                            android:layout_height="@dimen/checkout_field_icon_size"
                            android:layout_gravity="center_vertical|end"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_arrow_down"
                            app:tint="@color/text_tertiary" />
                    </FrameLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilReferenceNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_reference_number">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etReferenceNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPaymentNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/hint_payment_note">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPaymentNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Pembayaran terbagi ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_dialog"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvSplitLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_split_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/checkout_label_text"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/containerSplitPayments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvSplitRemaining"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/checkout_label_text"
                    tools:text="Remaining for Cash: $33.34" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddSplitPayment"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="@dimen/checkout_add_split_min_height"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/checkout_split_add"
                    android:textAllCaps="false"
                    android:textColor="@color/brand_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_dialog" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Detail pesanan (meja / pengantaran) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="@dimen/radius_dialog"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke"
            app:strokeWidth="1dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/checkout_section_order_details"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/checkout_label_text"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_table_number"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDeliveryAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_delivery_address"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDeliveryAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPostalAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDeliveryFee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hint_delivery_fee"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDeliveryFee"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
