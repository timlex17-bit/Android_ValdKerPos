<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:text="@string/amount_zero_usd"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCustomerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
                android:text="@string/label_customer"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvCustomerPointsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
                android:text="@string/checkout_points_zero"
            android:textColor="#065F46"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPaymentMethodLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
                android:text="@string/label_payment_method"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etCashReceived"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:hint="@string/hint_cash_received"
            android:inputType="numberDecimal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvChange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingTop="4dp"
                android:text="@string/checkout_change_zero"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvBankLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:text="@string/label_bank_account"
            android:textStyle="bold"
            android:visibility="gone" />

        <Spinner
            android:id="@+id/spBankAccount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etReferenceNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:hint="@string/hint_reference_number"
            android:inputType="text"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etPaymentNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top|start"
                android:hint="@string/hint_payment_note"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etTable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:hint="@string/hint_table_number"
            android:inputType="number"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etDeliveryAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:hint="@string/hint_delivery_address"
            android:inputType="textPostalAddress"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etDeliveryFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
                android:hint="@string/hint_delivery_fee"
            android:inputType="numberDecimal"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
