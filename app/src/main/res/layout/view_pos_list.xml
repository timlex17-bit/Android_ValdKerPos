<?xml version="1.0" encoding="utf-8"?>
<!--
  Daftar isi kasir - implementasi 4.

  KARTU HANYA DI SINI

  Kelompok isi adalah satu-satunya tempat kartu dipakai. Layar tidak dibungkus
  kartu berlapis: header punya bentuknya sendiri, aksi cepat punya kartunya
  sendiri, dan di antara keduanya tidak ada pembungkus tambahan. Kartu yang
  membungkus kartu hanya menggambar garis kedua yang tidak memisahkan apa pun.

  Kepala kelompok memakai ubin ikon berwarna kecil - warna yang sama dengan
  jenis barang di dalamnya - lalu judul, lalu lencana jumlah baris. Di kasir
  bengkel yang keranjangnya memuat servis, suku cadang, dan produk sekaligus,
  ubin warna itulah yang memberi tahu mata di mana satu kelompok berakhir.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/posListSection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="@dimen/pos_space_4"
    android:layout_marginEnd="@dimen/pos_space_4"
    android:background="@drawable/bg_pos_card"
    android:orientation="vertical"
    android:paddingStart="@dimen/pos_space_3"
    android:paddingEnd="@dimen/pos_space_3"
    android:paddingBottom="@dimen/pos_space_2">

    <!-- ══════ Kepala kelompok ══════ -->

    <LinearLayout
        android:id="@+id/layoutRetailContentHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/pos_gap_sm"
        android:paddingBottom="@dimen/pos_space_2">

        <ImageView
            android:id="@+id/imgSectionTile"
            style="@style/Widget.Pos.Tile.Small"
            android:background="@drawable/bg_pos_tile_blue"
            android:contentDescription="@null"
            android:src="@drawable/ic_pos_package"
            app:tint="@color/pos_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pos_space_2"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtSectionTitle"
                style="@style/TextAppearance.Pos.Item"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pos_section_lines"
                tools:text="Item scan ona" />

            <!-- Dipakai kasir bengkel untuk menyebut kendaraan yang dikerjakan. -->
            <TextView
                android:id="@+id/txtSectionSubtitle"
                style="@style/TextAppearance.Pos.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:visibility="gone"
                tools:text="B 1234 TL"
                tools:visibility="visible" />
        </LinearLayout>

        <!--
          Jumlah baris, sekaligus tombol kosongkan bon.

          Dua hal yang sempat membuatnya tidak terlihat sama sekali di ponsel:
          teksnya tidak pernah diisi saat berjalan - hanya ada tools:text yang
          cuma tampil di pratinjau Android Studio - sehingga yang tergambar
          adalah pil abu-abu KOSONG; dan tidak ada satu pun tanda bahwa ia
          bisa ditekan. Di tablet jumlahnya masih terbaca lewat panel samping,
          jadi yang kehilangan keterangan justru ponsel.

          Sekarang teksnya diisi RetailPOSFragment.updateSummary(), jadi pil
          itu benar-benar menunjukkan "3 item" alih-alih kosong. Tempatnya
          tidak dipindah: memindahkan aksi menghapus ke tempat baru adalah
          cara kehilangan keranjang yang sudah diisi.

          Tidak ada ikon silang di ujungnya. Sempat dicoba sebagai compound
          drawable, dan hasilnya ikon yang MEMAKAN lebar tapi tidak pernah
          tergambar - baik lewat app:drawableEndCompat maupun
          android:drawableEnd pada MaterialTextView. Atribut yang menyisakan
          ruang kosong tanpa menggambar apa pun lebih buruk daripada tidak ada
          ikonnya; keterangan aksinya dipasang lewat contentDescription.
        -->
        <TextView
            android:id="@+id/txtItemCount"
            style="@style/TextAppearance.Pos.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pos_space_2"
            android:background="@drawable/bg_pos_chip_neutral"
            android:gravity="center"
            android:minHeight="26dp"
            android:paddingStart="@dimen/pos_space_2"
            android:paddingEnd="@dimen/pos_space_2"
            android:text="@string/pos_zero_item"
            android:textColor="@color/pos_muted"
            tools:text="2 item" />
    </LinearLayout>

    <!-- ══════ Isi ══════ -->

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProducts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/pos_space_2"
            android:scrollbars="none" />

        <ProgressBar
            android:id="@+id/progressProducts"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/pos_accent"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/emptyStateScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/pos_space_4"
                android:paddingTop="@dimen/pos_space_3"
                android:paddingEnd="@dimen/pos_space_4"
                android:paddingBottom="@dimen/pos_space_3">

                <!--
                  Ukurannya sengaja kecil. Kartu ini mendapat sisa tinggi
                  layar setelah kepala, aksi cepat, bon, dan bilah bayar -
                  pada ponsel 360dp itu sekitar 150dp - dan keadaan kosong
                  yang lebih tinggi dari itu akan terpotong justru pada
                  kalimat yang memberi tahu kasir apa yang harus dilakukan.
                -->
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pos_tile_accent_lg"
                    android:contentDescription="@null"
                    android:padding="13dp"
                    android:src="@drawable/ic_pos_basket"
                    app:tint="@color/pos_accent" />

                <TextView
                    style="@style/TextAppearance.Pos.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pos_gap_sm"
                    android:gravity="center"
                    android:text="@string/pos_empty_title"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvEmptyState"
                    style="@style/TextAppearance.Pos.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:text="Skaneia barcode ka buka produtu atu hahu konta." />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

</LinearLayout>
