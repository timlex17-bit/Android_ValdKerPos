<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!--
      Strip ungu setinggi bilah status. Layar ini berlatar terang, sementara
      seluruh aplikasi memakai bilah status ungu dengan ikon terang; tanpa
      strip ini, di Android 15+ jam dan ikon baterai putih akan berada di atas
      latar #F6F8FB dan praktis tidak terlihat. Tingginya diisi runtime oleh
      SystemBars.fitStatusScrim(), jadi nol di perangkat tanpa bilah status.
    -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_bar_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintBottom_toTopOf="@id/actionRow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:background="@drawable/bg_login_logo"
            android:contentDescription="@string/splash_image_placeholder"
            android:gravity="center"
            android:text="$"
            android:textColor="#FFFFFF"
            android:textSize="54sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/splash_title_2"
            android:textColor="@color/valora_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/splash_subtitle_2"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnSplashBack"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_login_button_secondary"
            android:minHeight="0dp"
            android:text="@string/splash_back"
            android:textAllCaps="false"
            android:textColor="@color/brand_on_tint"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSplashNext"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_login_button_primary"
            android:minHeight="0dp"
            android:text="@string/splash_next"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
