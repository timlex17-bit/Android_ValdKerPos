<?xml version="1.0" encoding="utf-8"?>
<!--
  Baris bon terbuka untuk POS di MainActivity.

  Ada sebagai berkas bersama karena varian lanskap activity_main.xml sama
  sekali tidak memuat chip bon: chipGroupDrafts, chipDraftA/B/C, dan
  chipAddDraft hanya ada di potret dan tablet. MainActivity menjaga diri
  dengan "if (chipGroupDrafts == null) return;", jadi tidak ada yang crash -
  daftar bon terbuka hanya diam-diam menghilang begitu perangkat diputar.

  Chip-nya memakai gaya bersama Widget.Valora.FilterChip, sama dengan chip bon
  di POS retail/bengkel dan chip filter di modul lain.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <HorizontalScrollView
        android:id="@+id/draftChipScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupDrafts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="0dp"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDraftA"
                style="@style/Widget.Valora.FilterChip"
                android:checked="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/draft_a_preview" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDraftB"
                style="@style/Widget.Valora.FilterChip"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/draft_b_preview" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDraftC"
                style="@style/Widget.Valora.FilterChip"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/draft_walkin_preview" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!--
      Chip "+" berdiri di luar area gulir supaya tetap terjangkau saat daftar
      bon sudah panjang; di layout lama ia ikut tergulir dan hilang di kanan.
    -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipAddDraft"
        style="@style/Widget.Valora.FilterChip"
        android:layout_marginStart="6dp"
        android:minWidth="@dimen/pos_draft_chip_min_width"
        android:text="@string/draft_add"
        android:textAlignment="center"
        android:textColor="@color/text_on_brand"
        android:textSize="15sp"
        app:chipBackgroundColor="@color/brand_primary"
        app:chipStrokeWidth="0dp" />

</LinearLayout>
