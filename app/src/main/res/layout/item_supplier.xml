<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvSupplierName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Wfour Store"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSupplierEdit"
            android:layout_marginEnd="10dp"/>

        <TextView
            android:id="@+id/tvSupplierContact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Contact: 77328324"
            android:textSize="13sp"
            android:textColor="@color/icon_muted"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvSupplierName"
            app:layout_constraintTop_toBottomOf="@id/tvSupplierName"
            app:layout_constraintEnd_toEndOf="@id/tvSupplierName"/>

        <TextView
            android:id="@+id/tvSupplierCell"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Cell: 34343484"
            android:textSize="13sp"
            android:textColor="@color/icon_muted"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="@id/tvSupplierName"
            app:layout_constraintTop_toBottomOf="@id/tvSupplierContact"
            app:layout_constraintEnd_toEndOf="@id/tvSupplierName"/>

        <TextView
            android:id="@+id/tvSupplierMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="wfourstore@gmail.com • Liberdade dan Imprensa"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@id/tvSupplierName"
            app:layout_constraintTop_toBottomOf="@id/tvSupplierCell"
            app:layout_constraintEnd_toEndOf="@id/tvSupplierName"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSupplierEdit"
            style="@style/Widget.Valora.RowAction.Edit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/row_action_gap"
            android:text="@string/action_edit"
            app:layout_constraintEnd_toStartOf="@id/btnSupplierDelete"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSupplierDelete"
            style="@style/Widget.Valora.RowAction.Delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
