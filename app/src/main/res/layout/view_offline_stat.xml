<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu kotak angka ringkasan di Pesanan Offline.

  Ditulis sekali dan di-<include> empat kali, bukan disalin empat kali,
  supaya keempatnya pasti sama tinggi dan sama gayanya. Nilai dan warnanya
  diisi dari kode lewat findViewById pada tiap include.

  Angkanya autoSizeText: pada ponsel sempit kotaknya tetap kecil, dan jumlah
  empat digit masih muat karena hurufnya mengecil sendiri alih-alih terpotong.

  Lebarnya wrap_content dengan minWidth, BUKAN 0dp berbobot. Dulu keempat
  kotak dipaksa membagi lebar layar: pada ponsel 320dp masing-masing tinggal
  sekitar 70dp, labelnya terpotong, dan tidak ada cara melihat sisanya.
  Sekarang barisnya bisa digeser mendatar, jadi setiap kotak boleh selebar
  yang dibutuhkan isinya. Tingginya match_parent supaya keempatnya tetap
  sama tinggi walau labelnya berbeda panjang.

  Jarak antarkotak TIDAK ditulis di sini melainkan di tag <include>: atribut
  layout_* pada akar berkas yang disertakan selalu kalah oleh tag include.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:minWidth="@dimen/offline_stat_min_width"
    app:cardBackgroundColor="@color/surface_subtle"
    app:cardCornerRadius="@dimen/radius_surface_sm"
    app:cardElevation="0dp"
    app:strokeColor="@color/stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/statDot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/text_tertiary" />

            <TextView
                android:id="@+id/tvStatLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Menunggu" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:maxLines="1"
            android:text="@string/pos_zero_count"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="12" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
