<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu item makanan di dalam kartu order.

  Dua tombol aksi saja, dan keduanya hanya muncul kalau transisinya sah
  menurut tabel kontrak: satu langkah maju, satu pembatalan. Menawarkan tombol
  yang pasti dijawab 400 oleh server adalah cara tercepat membuat kru dapur
  berhenti membaca pesan galat.

  Tinggi tombol 56dp - ditekan dengan tangan yang mungkin sedang memegang
  wajan, bukan dengan ujung jari yang santai.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemQty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:minWidth="44dp"
            android:textColor="@color/brand_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="2 x" />

        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:text="Nasi Goreng" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/state_warning"
            android:contentDescription="@string/cd_kitchen_status"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:textColor="@color/text_on_brand"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="SIAP" />

        <!--
          Durasi dihitung di klien dari kitchen_status_updated_at; server tidak
          pernah mengirim angka "sudah menunggu berapa lama". Disembunyikan
          kalau timestamp-nya tidak terbaca, bukan diisi tebakan.
        -->
        <TextView
            android:id="@+id/tvItemSince"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="4m" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemForward"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="56dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textAllCaps="false"
            android:textColor="@color/text_on_brand"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="@dimen/radius_surface_sm"
            tools:text="Mulai masak" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnItemCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minHeight="56dp"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/kitchen_action_cancelled"
            android:textAllCaps="false"
            android:textColor="@color/state_danger"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="@dimen/radius_surface_sm"
            app:strokeColor="@color/stroke" />
    </LinearLayout>

    <View
        android:id="@+id/itemDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/stroke_soft" />

</LinearLayout>
