<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/valora_surface"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitleProductReturnAdd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/product_return_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="@dimen/dialog_scroll_max_height"
        android:layout_marginTop="14dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:background="@android:color/transparent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/surface_subtle"
                app:cardCornerRadius="@dimen/radius_dialog"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/product_return_details"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/text_primary" />

                    <!-- Return Mode -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/product_return_type"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgReturnMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rbByInvoice"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/brand_primary"
                            android:checked="true"
                            android:text="@string/product_return_by_invoice"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <RadioButton
                            android:id="@+id/rbManual"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:buttonTint="@color/brand_primary"
                            android:text="@string/product_return_manual"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </RadioGroup>

                    <!-- Invoice Section -->
                    <LinearLayout
                        android:id="@+id/layoutInvoiceSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/label_invoice"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#FFFFFF"
                            app:cardCornerRadius="@dimen/radius_dialog"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/stroke_strong">

                            <Spinner
                                android:id="@+id/spOrder"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvCustomerAuto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/product_return_customer_none"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/product_return_item_in_invoice"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#FFFFFF"
                            app:cardCornerRadius="@dimen/radius_dialog"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/stroke_strong">

                            <Spinner
                                android:id="@+id/spOrderItem"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="@string/field_qty_return">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etQty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/field_qty"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_tertiary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/field_unit_price"
                        app:prefixText="@string/money_prefix"
                        app:prefixTextColor="@color/text_secondary"
                        app:expandedHintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etUnitPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:enabled="false"
                                android:focusable="false"
                                android:importantForAutofill="no"
                                android:inputType="none"
                                android:longClickable="false"
                                android:textColor="@color/text_primary"
                                android:textIsSelectable="false" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddItem"
                            style="@style/Widget.Valora.Dialog.Button.Filled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="52dp"
                            android:text="@string/action_add_invoice_item"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Manual Section -->
                    <LinearLayout
                        android:id="@+id/layoutManualSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvManualHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/product_return_manual_hint"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:text="@string/label_product"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="#FFFFFF"
                            app:cardCornerRadius="@dimen/radius_dialog"
                            app:cardElevation="0dp"
                            app:strokeWidth="1dp"
                            app:strokeColor="@color/stroke_strong">

                            <Spinner
                                android:id="@+id/spManualProduct"
                                android:layout_width="match_parent"
                                android:layout_height="54dp"
                                android:background="@android:color/transparent"
                                android:paddingStart="14dp"
                                android:paddingEnd="14dp" />
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:hint="@string/field_qty_return">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etManualQty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/field_qty"
                                android:inputType="number"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_tertiary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/field_unit_price"
                        app:prefixText="@string/money_prefix"
                        app:prefixTextColor="@color/text_secondary"
                        app:expandedHintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etManualUnitPrice"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_tertiary" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddManualItem"
                            style="@style/Widget.Valora.Dialog.Button.Filled"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:minHeight="52dp"
                            android:text="@string/action_add_manual_item"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Shared Note -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/field_reason_note">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top|start"
                            android:inputType="textMultiLine"
                            android:minLines="2"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_tertiary" />
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Preview Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/surface_subtle"
                app:cardCornerRadius="@dimen/radius_dialog"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/product_return_items_preview"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/product_return_no_items"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPreview"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dialog_list_height"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tvItemsPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <Space
                android:layout_width="match_parent"
                android:layout_height="22dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
