<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/field_name_required"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <!-- Kotak isian uang: "$" menetap di dalam kotak, di luar teks yang diedit. -->
        <LinearLayout
            style="@style/Widget.Valora.MoneyFieldBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                style="@style/TextAppearance.Valora.MoneyPrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/money_prefix" />

            <EditText
                style="@style/Widget.Valora.EditText.Money"
                android:id="@+id/etPrice"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:background="@drawable/bg_dialog_input"
                android:hint="@string/field_price_required"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary" />
        </LinearLayout>

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dialog_input"
            android:hint="@string/field_duration_minutes"
            android:inputType="number"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="96dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dialog_input"
            android:gravity="top"
            android:hint="@string/field_description"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="3"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <Switch
            android:id="@+id/swActive"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="@string/field_active"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
