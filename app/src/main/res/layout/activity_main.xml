<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:clipToPadding="false">

    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/pos_accent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      Kepala ungu restoran. Satu berkas, dipakai ponsel, lanskap, dan tablet -
      lihat view_pos_header_resto.xml untuk alasannya.
    -->
    <include
        layout="@layout/view_pos_header_resto"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      Baris bon. Duduk di bawah kepala, di atas latar lavender - sama persis
      dengan kasir retail dan bengkel.

      Sempat HILANG sama sekali. Sebelum kepala restoran ditulis ulang, baris
      bon ada di dalamnya lewat <include view_pos_draft_row>; penulisan ulang
      itu tidak membawanya serta, dan karena MainActivity menjaga diri dengan
      "if (chipGroupDrafts == null) return;", tidak ada crash maupun galat -
      kasir restoran hanya kehilangan seluruh cara berpindah bill dan membuka
      bill baru, diam-diam.
    -->
    <include
        android:id="@+id/posBonRow"
        layout="@layout/view_pos_bon_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pos_space_4"
        android:layout_marginTop="@dimen/pos_space_4"
        android:layout_marginEnd="@dimen/pos_space_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nativeHeader" />

    <!-- CONTENT AREA -->

        <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/posBonRow"
        app:layout_constraintBottom_toTopOf="@id/bottomCategoryBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Categories + Cart Bar -->
    <include
        layout="@layout/view_pos_category_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Global Overlay Container -->
    <FrameLayout
        android:id="@+id/overlayContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="100dp"
        android:translationZ="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
