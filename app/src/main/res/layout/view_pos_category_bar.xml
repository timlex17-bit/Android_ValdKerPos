<?xml version="1.0" encoding="utf-8"?>
<!--
  Bilah kategori di dasar POS MainActivity.

  Berkas bersama karena varian lanskap tidak memuat bottomCategoryBar sama
  sekali, sementara MainActivity.applyBusinessTypeUi() menyetel
  {@code lp.bottomToTop = R.id.bottomCategoryBar} tanpa penjagaan. Di lanskap
  acuan itu menggantung, fragmentContainer setinggi 0dp kehilangan batas
  bawahnya, dan area isi POS menyusut jadi nol - layar tampak kosong sampai
  perangkat diputar kembali ke potret.

  Tingginya wrap_content dengan minHeight supaya ikut tumbuh bersama ukuran
  huruf sistem, bukan terkunci 72dp seperti sebelumnya.

  MARGINNYA ADA DI TAG <include>, BUKAN DI SINI

  Ketika sebuah <include> menyebutkan layout_width dan layout_height, Android
  membangun LayoutParams dari atribut tag include itu saja dan membuang semua
  atribut layout_* milik akar berkas yang disertakan. Jadi layout_margin yang
  ditulis di sini diam-diam bernilai nol - bilah menempel ke tepi kiri dan ke
  dasar jendela, persis yang terlihat di tablet. Margin @dimen/category_bar_margin
  sekarang ditulis di ketiga tag include (layout/, layout-sw600dp/, layout-land/
  activity_main.xml). Jangan memindahkannya kembali ke sini.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomCategoryBar"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/category_bar_min_height"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_surface"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="false">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:clipToPadding="false"
        android:minHeight="@dimen/category_chip_height"
        android:overScrollMode="never"
        android:paddingStart="@dimen/category_bar_padding"
        android:paddingTop="@dimen/category_bar_padding"
        android:paddingEnd="@dimen/category_bar_padding"
        android:paddingBottom="@dimen/category_bar_padding" />

</com.google.android.material.card.MaterialCardView>
