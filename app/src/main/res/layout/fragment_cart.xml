<?xml version="1.0" encoding="utf-8"?>
<!--
  Keranjang kasir - varian ponsel (laci dari kanan).

  Susunannya kini memakai token bersama (@color/surface, @color/stroke,
  @dimen/radius_*) dan string resource, bukan belasan hex dan teks Tetum yang
  ditulis langsung di layout. Sebelum ini judul "Karosa", tombol "Kontinua
  Pagamentu", dan "Your cart is empty" hanya ada dalam satu bahasa - berkas
  terjemahan values-in dan values-b+tet tidak pernah dipakai keranjang.

  BEDA YANG DISENGAJA DENGAN VARIAN TABLET

  Varian tablet ada di layout-sw600dp/fragment_cart.xml. Di sana keranjang
  bukan laci melainkan kolom tetap di sisi kanan layar kasir, jadi DUA id di
  bawah ini sengaja TIDAK ADA di berkas itu:

    - viewDim       latar redup. Tidak ada yang perlu diredupkan; kolom
                    keranjang berdiri sejajar dengan daftar menu.
    - btnCloseCart  tombol tutup. Kolomnya bagian tetap dari layar kasir
                    dan tidak pernah ditutup, jadi tombol silang hanya akan
                    menyisakan kolom kosong selebar 340dp.

  CartFragment menjaga keduanya dengan pemeriksaan null
  (findViewById lalu "if (btnClose != null)", dan dim disambungkan hanya bila
  ditemukan), jadi ketiadaannya aman - bukan kelalaian yang perlu "diperbaiki"
  dengan menyalin kedua view itu ke varian tablet. Selain dua id tersebut,
  semua id yang dibaca CartFragment sengaja sama persis di kedua berkas.

  Lint menandai ini sebagai InconsistentLayout dan peringatannya sengaja tidak
  dimatikan dengan tools:ignore - tapi jangan mengandalkan peringatan itu untuk
  menjelaskan keadaan ini, ia tenggelam di antara seribu peringatan lain.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartOverlayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Latar redup. Menutup laci saat disentuh; lihat CartFragment. -->
    <View
        android:id="@+id/viewDim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#66000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/cartRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_cart_drawer"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_max="@dimen/cart_drawer_max_width"
        app:layout_constraintWidth_percent="1">

        <!-- ===== Kepala ===== -->
        <LinearLayout
            android:id="@+id/cartHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="10dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tvCartTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_cart"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCartCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="3 items" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseCart"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close_cart"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/stroke_soft" />

        <!--
          Meja dan pelayan dine-in. Hanya terlihat pada toko restoran yang
          modul "tables"/"waiters"-nya hidup; tiap tombol disembunyikan
          sendiri-sendiri karena kedua modul bisa menyala terpisah.
        -->
        <LinearLayout
            android:id="@+id/rowDineInAssignment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickTable"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_surface_sm"
                app:strokeColor="@color/stroke" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickWaiter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                app:cornerRadius="@dimen/radius_surface_sm"
                app:strokeColor="@color/stroke" />
        </LinearLayout>

        <!-- ===== Isi ===== -->
        <FrameLayout
            android:id="@+id/cartContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCart"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_cart" />

            <!--
              Keadaan kosong. Dulu hanya satu baris teks abu-abu rata kiri di
              pojok atas; id-nya tetap tvCartEmpty supaya render() tidak perlu
              tahu bentuknya berubah.
            -->
            <LinearLayout
                android:id="@+id/tvCartEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="@dimen/cart_empty_icon_size"
                    android:layout_height="@dimen/cart_empty_icon_size"
                    android:alpha="0.28"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_shopping_cart"
                    app:tint="@color/text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/msg_cart_empty"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cart_empty_message"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ===== Kaki: ringkasan + aksi ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="12dp"
                android:background="@color/stroke_soft" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.06"
                    android:text="@string/label_subtotal"
                    android:textAllCaps="true"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtotal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="24sp"
                    android:autoSizeMinTextSize="15sp"
                    android:autoSizeTextType="uniform"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="@string/amount_zero_usd"
                    android:textColor="@color/brand_primary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="$128.45" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinuePayment"
                style="@style/Widget.Valora.PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="@dimen/cart_primary_action_min_height"
                android:text="@string/cart_continue_payment"
                app:icon="@drawable/ic_bag"
                app:iconGravity="textStart"
                app:rippleColor="#33FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelOrder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="@dimen/cart_secondary_action_min_height"
                android:text="@string/cart_cancel_order"
                android:textAllCaps="false"
                android:textColor="@color/state_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radius_surface_sm" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
