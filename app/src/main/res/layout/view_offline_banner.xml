<?xml version="1.0" encoding="utf-8"?>
<!--
  Bilah pemberitahuan luring di layar kasir.

  Menggantikan Toast "No internet connection. Showing local POS data." yang
  dulu melayang di tengah-bawah layar. Tiga hal yang salah dengan toast itu,
  dan ketiganya berasal dari sifat toast, bukan dari kalimatnya:

  1. Ia menutupi isi layar - tepat di atas bilah kategori dan baris kartu menu
     paling bawah, dua hal yang justru ditekan kasir.
  2. Letaknya tidak tetap: melayang di atas apa pun yang sedang tampil.
  3. Ia muncul lagi setiap kali data dimuat ulang, walaupun keadaannya tidak
     berubah - luring tetap luring.

  Bilah ini menyatu dengan tata letak: ia menempati barisnya sendiri di bawah
  kepala layar, jadi isi di bawahnya bergeser, bukan tertutup. Ia hanya
  muncul saat keadaan BERUBAH menjadi luring dan hilang sendiri saat sambungan
  kembali - tanpa penghitung waktu; lihat OfflineBanner.

  Tingginya wrap_content dengan teks satu baris berelipsis: pada layar sempit
  kalimatnya memendek, bukan melipat dan mendorong isi layar ke bawah.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offlineBanner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/offline_banner_margin"
    android:layout_marginEnd="@dimen/offline_banner_margin"
    android:layout_marginBottom="@dimen/offline_banner_margin"
    android:visibility="gone"
    app:cardBackgroundColor="@color/offline_banner_bg"
    app:cardCornerRadius="@dimen/radius_surface_sm"
    app:cardElevation="0dp"
    app:strokeColor="@color/offline_banner_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:minHeight="@dimen/offline_banner_min_height"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="@dimen/offline_banner_icon"
            android:layout_height="@dimen/offline_banner_icon"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_wifi_off"
            app:tint="@color/offline_banner_text" />

        <TextView
            android:id="@+id/tvOfflineBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/offline_banner_message"
            android:textColor="@color/offline_banner_text"
            android:textSize="@dimen/offline_banner_text"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOfflineRetry"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="@dimen/offline_banner_action_min_height"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/action_retry"
            android:textAllCaps="false"
            android:textColor="@color/offline_banner_text"
            android:textSize="@dimen/offline_banner_text"
            android:textStyle="bold"
            app:cornerRadius="@dimen/radius_surface_sm"
            app:rippleColor="@color/offline_banner_text" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
