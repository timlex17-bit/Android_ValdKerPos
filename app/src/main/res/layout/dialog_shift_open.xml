<?xml version="1.0" encoding="utf-8"?>
<!--
  Dibungkus ScrollView agar isinya tetap terjangkau di layar pendek.

  Di lanskap ponsel tinggi yang tersisa untuk sebuah dialog bisa di bawah
  300dp; tanpa pembungkus ini kolom terakhir dan tombolnya berada di luar
  layar dan tidak ada cara menggulirnya. fillViewport dibiarkan false supaya
  dialog pendek tetap membungkus isinya alih-alih memuai.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:scrollbars="none">

    <LinearLayout
   
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shift_open_title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shift_open_hint"
            android:textSize="13sp"
            android:paddingBottom="12dp"/>

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etOpeningCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shift_open_cash_hint"
            android:inputType="numberDecimal"/>

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/shift_open_note_hint"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>
