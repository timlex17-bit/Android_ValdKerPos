<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar masuk.

  SATU KODE TOKO, SEKALI SEUMUR PERANGKAT

  Dulu layar ini meminta tiga hal setiap kali: kode toko, nama pengguna, dan
  sandi. Kode toko tidak pernah berubah sepanjang umur perangkat - satu tablet
  melayani satu toko - jadi mengetiknya setiap pagi hanyalah tiga belas
  ketukan yang jawabannya sudah diketahui aplikasi, dan satu kesempatan salah
  ketik pada kolom yang paling tidak dimengerti kasir.

  Sekarang kolom itu punya dua keadaan:

  - Perangkat belum diaktifkan: kolom kode toko tampil bersama penjelasan
    satu kalimat bahwa ini hanya diminta sekali.
  - Perangkat sudah diaktifkan: kolom itu hilang seluruhnya, diganti sebaris
    keterangan toko aktif beserta tombol "Ganti". Yang tersisa untuk diketik
    tiap hari hanyalah nama pengguna dan sandi.

  Dua keadaan itu memakai layout yang SAMA - LoginActivity hanya menyalakan
  atau mematikan satu wadah - supaya tidak ada dua berkas yang harus dijaga
  tetap mirip.

  Bentuknya mengikuti bahasa rupa aplikasi: kolom Material bergaya
  Widget.Valora.TextField (radius sama dengan seluruh popup), kartu ber-radius
  @dimen/radius_surface, dan ukuran dari token - bukan angka yang hanya hidup
  di berkas ini.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <!--
      Strip ungu setinggi bilah status. Layar ini berlatar terang sementara
      seluruh aplikasi memakai bilah status ungu dengan ikon terang; tanpa
      strip ini, di Android 15+ jam dan ikon baterai putih berada di atas
      latar terang dan praktis tidak terlihat. Tingginya diisi runtime oleh
      SystemBars.fitStatusScrim(), jadi nol di perangkat tanpa bilah status.
    -->
    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_bar_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topAccent"
        android:layout_width="0dp"
        android:layout_height="@dimen/login_accent_height"
        android:background="@color/brand_tint_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="24dp">

            <!-- ===== Identitas aplikasi ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:maxWidth="@dimen/login_card_max_width"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/login_logo_size"
                    android:layout_height="@dimen/login_logo_size"
                    android:background="@drawable/bg_login_logo"
                    android:gravity="center"
                    android:text="@string/login_logo_letter"
                    android:textColor="@color/text_on_brand"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="@color/valora_ink"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/login_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!--
              Tanpa android:id di tag include: id pada tag <include> menimpa
              id akar berkas yang disertakan, dan kartu ini perlu tetap
              bernama cardRight.
            -->
            <include
                layout="@layout/view_login_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
