<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar masuk.

  SATU TATA LETAK UNTUK SEMUA UKURAN LAYAR

  Bentuknya: kepala ungu di atas - logo, nama aplikasi, satu kalimat - lalu
  lembar putih bersudut membulat yang mengisi sisa layar dan memuat
  formulirnya. Ponsel, ponsel yang dimiringkan, dan tablet memakai berkas
  ini; yang berbeda hanyalah angka di values/, values-land/, dan
  values-sw600dp/. Sebelumnya tablet punya berkasnya sendiri dengan susunan
  dua panel, dan panel identitasnya adalah salinan yang harus dijaga tetap
  mirip dengan varian ponsel setiap kali salah satu disentuh.

  Formulirnya tidak ikut melebar: lebarnya ditahan @dimen/login_card_max_width
  dan diletakkan di tengah, karena kolom isian selebar layar tablet membuat
  mata menyeberang 1200dp untuk dua baris ketikan.

  BILAH STATUS

  Warna di balik bilah status datang dari LATAR AKAR yang ungu, bukan dari
  sebuah View strip. Cara lama - satu View setinggi bilah status yang diisi
  runtime - masih benar di layar lain, tetapi di sini ia digambar SEBELUM
  pita aksen muda, dan pita itu menutupinya: jam serta ikon baterai yang
  putih berdiri di atas lavender dan praktis hilang. Dengan latar akar yang
  ungu, apa pun yang tersisa di balik bilah status pasti ungu, di setiap
  ukuran layar dan kedua orientasi, tanpa bergantung pada urutan penulisan
  View. Isinya sendiri dijauhkan dari bilah status oleh SystemBars.padTop()
  pada @id/content.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_brand_hero">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ===== Kepala: identitas aplikasi, di atas ungu ===== -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="@dimen/login_hero_padding_top"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="@dimen/login_hero_padding_bottom">

            <TextView
                android:layout_width="@dimen/login_logo_size"
                android:layout_height="@dimen/login_logo_size"
                android:background="@drawable/bg_logo_on_brand"
                android:gravity="center"
                android:text="@string/login_logo_letter"
                android:textColor="@color/text_on_brand"
                android:textSize="@dimen/login_logo_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text_on_brand"
                    android:textSize="@dimen/login_app_name_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/text_on_brand_soft"
                    android:textSize="@dimen/login_hero_subtitle_text" />
            </LinearLayout>
        </LinearLayout>

        <!--
          Lembar putih. Tingginya 0dp dengan weight 1 supaya ia selalu
          mencapai tepi bawah jendela: bilah navigasi menjadi putih dengan
          ikon gelap seperti seluruh aplikasi, dan tidak ada pita ungu
          tersisa di bawah yang membuat batang gestur hilang.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_login_sheet"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="@dimen/login_sheet_padding_top"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="@dimen/login_sheet_padding_bottom">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!--
                  Tanpa android:id di tag include: id pada tag <include>
                  menimpa id akar berkas yang disertakan.

                  Lebar 0dp + constraintWidth_max + kedua sisi terikat =
                  selebar yang tersedia pada ponsel, berhenti di 440/480dp
                  pada layar lebar, dan selalu di tengah.
                -->
                <include
                    layout="@layout/view_login_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/login_card_max_width" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
