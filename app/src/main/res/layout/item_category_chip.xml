<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu chip kategori pada bilah menu yang bergulir mendatar di dasar layar
  kasir ponsel.

  Warnanya kini datang dari token bersama (@color/stroke, @color/text_primary,
  @dimen/radius_pill), bukan hex yang ditulis ulang di sini dan sekali lagi di
  CategoryAdapter. Tingginya wrap_content dengan minHeight 44dp supaya chip
  ikut tumbuh saat ukuran huruf sistem dinaikkan - versi lama mengunci 44dp,
  sehingga pada setelan huruf besar label terpotong di tengah.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:duplicateParentState="true"
    android:focusable="true"
    android:minWidth="80dp"
    android:minHeight="44dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_pill"
    app:cardElevation="0dp"
    app:rippleColor="@color/brand_tint"
    app:strokeColor="@color/stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/iconWrapper"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_category_icon"
            android:backgroundTint="@color/category_icon_bg_tint"
            android:duplicateParentState="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Bakery" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
