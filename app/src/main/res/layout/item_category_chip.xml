<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu chip kategori pada bilah menu yang bergulir mendatar di dasar layar
  kasir.

  SATU BERKAS UNTUK SEMUA LAYAR

  Dulu ada dua salinan - layout/ dan layout-sw600dp/ - yang berbeda hanya
  pada tujuh angka ukuran. Sekarang satu berkas membaca token @dimen, jadi
  ponsel dan tablet memakai susunan yang sama persis dan hanya ukurannya yang
  berbeda. Menambah ukuran layar baru berarti menambah nilai dimen, bukan
  menyalin berkas.

  Chipnya sengaja pendek: bilah ini duduk di dasar layar kasir dan setiap
  dp yang dipakainya diambil dari daftar menu tepat di atasnya.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCategory"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/category_chip_gap"
    android:clickable="true"
    android:duplicateParentState="true"
    android:focusable="true"
    android:minWidth="@dimen/category_chip_min_width"
    android:minHeight="@dimen/category_chip_height"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/radius_pill"
    app:cardElevation="0dp"
    app:rippleColor="@color/brand_tint"
    app:strokeColor="@color/stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:gravity="center"
        android:minHeight="@dimen/category_chip_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/category_chip_padding"
        android:paddingEnd="@dimen/category_chip_padding">

        <LinearLayout
            android:id="@+id/iconWrapper"
            android:layout_width="@dimen/category_chip_icon_box"
            android:layout_height="@dimen/category_chip_icon_box"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_category_icon"
            android:backgroundTint="@color/category_icon_bg_tint"
            android:duplicateParentState="true"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="@dimen/category_chip_icon"
                android:layout_height="@dimen/category_chip_icon"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/category_chip_text"
            android:textStyle="bold"
            tools:text="Bakery" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
