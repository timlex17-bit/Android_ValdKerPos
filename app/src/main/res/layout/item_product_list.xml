<?xml version="1.0" encoding="utf-8"?>
<!--
  Baris produk pada kasir (mode daftar). Dipakai kasir restoran mode daftar
  dan kasir retail.

  Dua hal yang diperbaiki di sini:

  1. Gambar produk sekarang gambar sungguhan. Sebelumnya imgProduct adalah
     ImageView 1dp yang disembunyikan "supaya adapter lama tidak crash",
     sehingga setelan "tampilkan gambar produk di POS" tidak melakukan apa pun
     pada mode daftar - ProductAdapter memuat gambarnya, lalu meletakkannya di
     kotak 1x1 piksel.
  2. Ukuran dan warna dari token bersama, bukan hex per berkas. Tombol kurang
     dulu merah dengan garis merah muda, tidak sama dengan kendali jumlah di
     keranjang maupun di kartu grid.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/product_card_margin"
    android:layout_marginTop="@dimen/product_card_margin"
    android:layout_marginEnd="@dimen/product_card_margin"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="@dimen/product_card_radius"
    app:cardElevation="0dp"
    app:rippleColor="@color/brand_tint"
    app:strokeColor="@color/stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/product_card_padding">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/product_thumb_size"
            android:layout_height="@dimen/product_thumb_size"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/surface_subtle"
            app:cardCornerRadius="@dimen/radius_surface_sm"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_soft"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_product_image"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_image_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/product_name_text"
                android:textStyle="bold"
                tools:text="Oli Mesin Castrol" />

            <TextView
                android:id="@+id/tvSku"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/product_meta_text"
                tools:text="SKU: OL-001" />

            <TextView
                android:id="@+id/tvStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/product_meta_text"
                tools:text="Stock: 24" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/brand_primary"
                android:textSize="@dimen/product_price_text"
                android:textStyle="bold"
                tools:text="$12.00" />

            <!--
              Kendali jumlah terlihat secara bawaan: RetailProductAdapter
              memakai tombol +/- di sini dan tidak pernah menyentuh visibilitas
              wadahnya. Kasir restoran yang menyembunyikannya sendiri lewat
              ProductAdapter. Menyembunyikannya di XML akan mematikan tombol
              tambah/kurang di kasir retail tanpa satu pun galat.
            -->
            <LinearLayout
                android:id="@+id/layoutQtyControl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_cart_stepper"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="2dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMinus"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cd_cart_decrease"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:backgroundTint="@color/surface"
                    app:cornerRadius="@dimen/radius_pill"
                    app:icon="@drawable/ic_remove"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/brand_primary"
                    app:strokeColor="@color/stroke"
                    app:strokeWidth="1dp"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/tvQty"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/pos_zero_count"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlus"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/cd_cart_increase"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:backgroundTint="@color/brand_primary"
                    app:cornerRadius="@dimen/radius_pill"
                    app:elevation="0dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/text_on_brand"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>

            <!--
              Tombol tambah versi ringkas. Tetap ada karena ProductAdapter
              memasang listener padanya; pada mode daftar seluruh barisnya
              yang bisa ditekan, jadi tombol ini disembunyikan.
            -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/Widget.Valora.PrimaryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="@dimen/product_action_height"
                android:text="@string/pos_add_to_cart"
                android:textSize="12sp"
                android:visibility="gone"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
