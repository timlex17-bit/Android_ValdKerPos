<?xml version="1.0" encoding="utf-8"?>
<!--
  POS kasir (retail) - potret.

  Susunannya sekarang persis sama dengan modul lain yang dirapikan
  (Pesanan Offline, Owner Chat): bilah atas ungu -> panel kendali -> isi ->
  satu aksi utama di dasar layar. Keempat bagiannya di-<include> dari berkas
  bersama, sehingga varian lanskap dan tablet memakai komponen dan id yang
  sama persis - tidak bisa lagi ada chip bon yang hanya muncul di potret.

  Bilah atas dan bilah bawah yang mengurus inset, bukan akar layout. Versi
  lama menambahkan tinggi bilah status sebagai padding pada akar yang berlatar
  abu-abu terang, sementara ikon bilah status dipaksa putih - di Android 15+
  hasilnya jam dan ikon baterai putih di atas abu-abu terang.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootRetailPos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <include layout="@layout/view_pos_topbar" />

    <include layout="@layout/view_pos_controls" />

    <com.google.android.material.card.MaterialCardView
    style="@style/Widget.Valora.PanelCard"
        android:id="@+id/cardRetailWorkspace"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1">

        <include layout="@layout/view_pos_list" />
    </com.google.android.material.card.MaterialCardView>

    <include layout="@layout/view_pos_checkout" />

</LinearLayout>
