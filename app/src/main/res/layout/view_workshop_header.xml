<?xml version="1.0" encoding="utf-8"?>
<!--
  4c - Kepala kasir bengkel: identitas toko dan kartu konteks kendaraan.

  DIPECAH JADI KOMPONEN AGAR LANSKAP TIDAK PERLU SALINAN

  Kasir bengkel dulu satu berkas sepanjang 700 baris, dan varian lanskap serta
  tabletnya adalah SALINAN penuh berkas itu. Salinan-salinan itu berhenti ikut
  diperbarui tanpa menimbulkan galat apa pun: selama berbulan-bulan, memutar
  perangkat menampilkan desain dari dua generasi sebelumnya. Sekarang tiga
  bloknya berdiri sebagai berkas sendiri, sehingga varian lanskap cukup
  menyusun ulang <include> yang sama - bukan menyalin isinya.

  Kartu kendaraan duduk DI DALAM blok ungu, bukan sebagai kartu terpisah di
  bawahnya. Ia menjawab "sedang mengerjakan siapa", yang merupakan bagian dari
  identitas layar ini - sama seperti nama toko - bukan bagian dari daftar
  barang.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardWorkshopHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pos_header"
    android:orientation="vertical"
    android:paddingStart="@dimen/pos_gutter"
    android:paddingEnd="@dimen/pos_gutter"
    android:paddingBottom="@dimen/pos_space_4">

    <!--
      Strip di belakang bilah status. Nama id-nya posHeaderScrim, sama dengan
      kasir retail dan restoran - dulu statusBarScrim, yaitu nama yang SAMA
      dengan View bertinta gelap milik activity_main. Kasir bengkel hidup di
      dalam activity_main, jadi dua View berbeda dengan satu id berada dalam
      satu pohon view sekaligus, dan siapa yang ditemukan findViewById
      bergantung pada urutan penelusuran - bukan sesuatu yang layak
      diandalkan untuk menentukan warna di belakang jam dan baterai.
    -->
    <View
        android:id="@+id/posHeaderScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pos_space_4"
        android:paddingTop="@dimen/pos_gap_sm"
        android:paddingEnd="@dimen/pos_space_4">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/pos_header_tile"
            android:layout_height="@dimen/pos_header_tile"
            android:background="@drawable/bg_pos_header_tile"
            android:contentDescription="@string/cd_shop_logo"
            android:padding="@dimen/pos_gap_sm"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pos_wrench"
            app:tint="@color/pos_on_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pos_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrand"
                    style="@style/TextAppearance.Pos.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Bengkel" />

                <TextView
                    android:id="@+id/tvPosTypeBadge"
                    style="@style/TextAppearance.Pos.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pos_space_2"
                    android:background="@drawable/bg_pos_pill_header"
                    android:drawablePadding="3dp"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/pos_on_accent"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_pos_lock"
                    app:drawableTint="@color/pos_on_accent"
                    tools:text="Bengkel"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvShopAddress"
                style="@style/TextAppearance.Pos.HeaderMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Land-Sky · Kasa 01" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ Kartu konteks kendaraan, di dalam header ══════ -->

    <LinearLayout
        android:id="@+id/layoutWorkshopSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pos_space_4"
        android:layout_marginTop="@dimen/pos_gap"
        android:layout_marginEnd="@dimen/pos_space_4"
        android:background="@drawable/bg_pos_header_card"
        android:orientation="vertical"
        android:padding="@dimen/pos_space_3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pos_field"
                android:contentDescription="@null"
                android:padding="@dimen/pos_gap_sm"
                android:scaleType="centerInside"
                android:src="@drawable/ic_pos_car"
                app:tint="@color/pos_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pos_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtWorkshopJobInfoLabel"
                    style="@style/TextAppearance.Pos.HeaderMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp"
                    android:visibility="gone"
                    android:text="@string/label_workshop_job_info" />

                <TextView
                    android:id="@+id/txtCustomerName"
                    style="@style/TextAppearance.Pos.Item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pos_on_accent"
                    android:textSize="14sp"
                    tools:text="Antonio da Costa" />

                <TextView
                    android:id="@+id/txtVehicleSummary"
                    style="@style/TextAppearance.Pos.HeaderMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11.5sp"
                    tools:text="Car · Toyota Hilux · B 1234 TL" />

                <TextView
                    android:id="@+id/txtWorkshopSummary"
                    style="@style/TextAppearance.Pos.HeaderMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textSize="11.5sp"
                    tools:text="Mekanik Jose Ximenes · WO-0142" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectCustomer"
                style="@style/Widget.Pos.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pos_space_2"
                android:text="@string/action_change"
                app:icon="@drawable/ic_pos_repeat" />
        </LinearLayout>

        <!--
          Chip ringkasan (mekanik, work order, booking). Tidak dihapus:
          kode menyalakan dan mematikannya sesuai isi bon.
        -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/layoutWorkshopChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pos_space_2"
            android:visibility="gone"
            app:chipSpacingHorizontal="@dimen/pos_space_1"
            app:singleLine="false"
            tools:visibility="visible">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMechanicSummary"
                style="@style/Widget.Pos.DraftChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Jose Ximenes" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWorkOrderSummary"
                style="@style/Widget.Pos.DraftChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="WO-0142" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBookingSummary"
                style="@style/Widget.Pos.DraftChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Rezerva" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</LinearLayout>
