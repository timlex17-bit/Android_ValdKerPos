<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar aktivasi perangkat: kode toko, sekali seumur pemasangan.

  Urutannya: onboarding -> LAYAR INI -> layar masuk. Sesudah kode tersimpan,
  layar ini tidak pernah tampil lagi; satu-satunya jalan kembali ke sini
  adalah tindakan "Ganti toko" di layar masuk.

  Alasannya dipisah dari layar masuk, bukan sekadar disembunyikan di sana:
  dua hal ini dijawab orang yang berbeda pada waktu yang berbeda. Kode toko
  dibacakan pemilik sekali saat tablet dipasang; nama pengguna dan sandi
  diketik kasir setiap pagi. Menaruh keduanya pada satu layar membuat
  yang jarang terlihat sama pentingnya dengan yang sering.

  Rupanya sengaja kembar dengan layar masuk - aksen, kartu, dan kolom yang
  sama - supaya keduanya terasa satu rangkaian, bukan dua aplikasi.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootActivation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <View
        android:id="@+id/statusBarScrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/status_bar_brand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/topAccent"
        android:layout_width="0dp"
        android:layout_height="@dimen/login_accent_height"
        android:background="@color/brand_tint_soft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="@dimen/login_logo_size"
                    android:layout_height="@dimen/login_logo_size"
                    android:background="@drawable/bg_login_logo"
                    android:gravity="center"
                    android:text="@string/login_logo_letter"
                    android:textColor="@color/text_on_brand"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/app_name"
                        android:textColor="@color/valora_ink"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/activation_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <include
                layout="@layout/view_activation_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
