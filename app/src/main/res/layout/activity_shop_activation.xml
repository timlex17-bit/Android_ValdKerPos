<?xml version="1.0" encoding="utf-8"?>
<!--
  Layar aktivasi perangkat: kode toko, sekali seumur pemasangan.

  Urutannya: onboarding -> LAYAR INI -> layar masuk. Sesudah kode tersimpan,
  layar ini tidak pernah tampil lagi; satu-satunya jalan kembali ke sini
  adalah tindakan "Ganti toko" di layar masuk.

  Alasannya dipisah dari layar masuk, bukan sekadar disembunyikan di sana:
  dua hal ini dijawab orang yang berbeda pada waktu yang berbeda. Kode toko
  dibacakan pemilik sekali saat tablet dipasang; nama pengguna dan sandi
  diketik kasir setiap pagi.

  Rupanya sengaja kembar dengan layar masuk - kepala ungu yang sama, lembar
  putih yang sama, token ukuran yang sama - supaya keduanya, yang dilihat
  berurutan dalam hitungan detik, terasa satu rangkaian dan bukan dua
  aplikasi. Penjelasan tentang bilah status dan tentang satu tata letak untuk
  semua ukuran layar ada di activity_login.xml.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootActivation"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_brand_hero">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- ===== Kepala: identitas aplikasi, di atas ungu ===== -->
        <LinearLayout
            android:id="@+id/hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="@dimen/login_hero_padding_top"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="@dimen/login_hero_padding_bottom">

            <TextView
                android:layout_width="@dimen/login_logo_size"
                android:layout_height="@dimen/login_logo_size"
                android:background="@drawable/bg_logo_on_brand"
                android:gravity="center"
                android:text="@string/login_logo_letter"
                android:textColor="@color/text_on_brand"
                android:textSize="@dimen/login_logo_text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text_on_brand"
                    android:textSize="@dimen/login_app_name_text"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/activation_subtitle"
                    android:textColor="@color/text_on_brand_soft"
                    android:textSize="@dimen/login_hero_subtitle_text" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_login_sheet"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingStart="@dimen/login_screen_padding"
            android:paddingTop="@dimen/login_sheet_padding_top"
            android:paddingEnd="@dimen/login_screen_padding"
            android:paddingBottom="@dimen/login_sheet_padding_bottom">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    layout="@layout/view_activation_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="@dimen/login_card_max_width" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
