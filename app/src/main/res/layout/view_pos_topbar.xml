<?xml version="1.0" encoding="utf-8"?>
<!--
  Header kasir - implementasi 4.

  Satu blok ungu yang melengkung di dua sudut bawahnya, memuat tiga hal
  sekaligus: identitas toko, lencana tipe terkunci, dan KOTAK PENCARIAN.

  KENAPA PENCARIAN PINDAH KE DALAM HEADER

  Di implementasi sebelumnya pencarian adalah blok tersendiri di bawah header,
  dipisahkan garis. Memindahkannya ke dalam header menghemat satu blok penuh
  di layar yang tingginya selalu kurang - dan secara arti ia memang milik
  header: mencari produk adalah cara MEMULAI transaksi, bukan bagian dari
  daftar yang sudah ada.

  Tombol pindai duduk di dalam kotak pencarian, bukan di sampingnya. Keduanya
  menjawab pertanyaan yang sama ("barang apa ini?") lewat dua cara, jadi
  menyatukannya dalam satu kotak memberi tahu kasir bahwa keduanya setara.

  Sudut atas TIDAK dibulatkan: ia menempel pada bilah status, dan
  membulatkannya akan meninggalkan dua celah berlatar ground di pojok layar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pos_header"
    android:orientation="vertical"
    android:paddingBottom="@dimen/pos_space_4">

    <!--
      Strip di belakang bilah status. Tingginya nol di layout dan ditumbuhkan
      SystemBars.fitStatusScrim(); di Android 15+ warna bilah status yang
      disetel lewat setStatusBarColor diabaikan, jadi warnanya harus datang
      dari tata letak. Transparan di sini karena header di belakangnya sudah
      ungu - satu warna, bukan dua lapis ungu yang bisa berbeda tipis.
    -->
    <View
        android:id="@+id/posHeaderScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@android:color/transparent" />

    <!-- ══════ Identitas ══════ -->

    <LinearLayout
        android:id="@+id/cardPosHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pos_space_4"
        android:paddingTop="@dimen/pos_gap_sm"
        android:paddingEnd="@dimen/pos_space_4">

        <!--
          Tanda toko. ImageView karena kode yang sudah ada memuat logo toko ke
          sini lewat Glide; tanpa logo yang terlihat adalah ubin putih
          transparan, tetap sesuai desain.
        -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/pos_header_tile"
            android:layout_height="@dimen/pos_header_tile"
            android:background="@drawable/bg_pos_header_tile"
            android:contentDescription="@string/cd_shop_logo"
            android:padding="@dimen/pos_gap_sm"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_pos_store"
            app:tint="@color/pos_on_accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pos_space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBrand"
                    style="@style/TextAppearance.Pos.Mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Retail" />

                <!--
                  Lencana terkunci. Gembok + nama tipe. Sengaja BUKAN Chip:
                  Chip Material punya keadaan tertekan dan ripple, yang
                  mengundang jari mencobanya - padahal tipe ditentukan akun
                  dan tidak bisa dipindah dari sini.
                -->
                <TextView
                    android:id="@+id/tvPosTypeBadge"
                    style="@style/TextAppearance.Pos.Badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pos_space_2"
                    android:background="@drawable/bg_pos_pill_header"
                    android:drawablePadding="3dp"
                    android:paddingStart="6dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:textColor="@color/pos_on_accent"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_pos_lock"
                    app:drawableTint="@color/pos_on_accent"
                    tools:text="Retail"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvShopAddress"
                style="@style/TextAppearance.Pos.HeaderMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                tools:text="Land-Sky · Kasa 01 · Maria" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ Pencarian + pindai ══════ -->

    <LinearLayout
        android:id="@+id/cardSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/pos_search_height"
        android:layout_marginStart="@dimen/pos_space_4"
        android:layout_marginTop="@dimen/pos_gap"
        android:layout_marginEnd="@dimen/pos_space_4"
        android:background="@drawable/bg_pos_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/pos_gap"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search"
            app:tint="@color/pos_faint" />

        <EditText
            android:id="@+id/tvSearchHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pos_gap_sm"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/archivo_semibold"
            android:hint="@string/pos_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/pos_ink"
            android:textColorHint="@color/pos_faint"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnHeaderBarcode"
            android:layout_width="@dimen/pos_scan_button"
            android:layout_height="@dimen/pos_scan_button"
            android:background="@drawable/bg_pos_scan_button"
            android:contentDescription="@string/cd_scan_barcode"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_barcode"
            app:tint="@color/pos_accent" />
    </LinearLayout>

</LinearLayout>
