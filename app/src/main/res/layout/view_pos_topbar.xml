<?xml version="1.0" encoding="utf-8"?>
<!--
  Bilah atas POS kasir: identitas toko + pemindai barcode.

  Ditulis sekali dan di-<include> oleh tata letak potret, lanskap, dan tablet.
  Sebelum ini ketiga varian menyalin isi bilahnya masing-masing, dan salinan
  lanskapnya sudah menyimpang: chip bon (chipDraftA/B/C, chipGroupDrafts,
  chipAddDraft) hilang seluruhnya di sana, jadi memutar perangkat membuat
  daftar bon terbuka lenyap tanpa jejak. Dengan satu sumber, penyimpangan
  seperti itu tidak mungkin terjadi lagi.

  KARTU, BUKAN BILAH UNGU RATA TEPI

  Kasir retail dulu satu-satunya kasir yang kepalanya berupa balok ungu rata
  tepi, sementara kasir restoran dan bengkel memakai kartu membulat di atas
  latar aplikasi. Perbedaannya paling terasa di tablet: ketiga kasir dipakai
  orang yang sama di perangkat yang sama, tetapi yang satu terlihat seperti
  aplikasi lain. Sekarang resepnya sama persis dengan kepala kasir restoran -
  kartu radius @dimen/radius_surface, latar bg_header, bayangan 2dp.

  Strip ungu di belakang bilah status tidak ikut hilang: ia pindah ke
  posHeaderScrim, cara yang dipakai activity_main dan setiap layar lain yang
  bagian atasnya terang. RetailPOSFragment mengisi tingginya lewat
  SystemBars.fitStatusScrim(). Tanpa itu, di Android 15+ warna status bar yang
  disetel lewat setStatusBarColor diabaikan dan yang tersisa hanyalah jam
  putih di atas latar terang.

  Namanya sengaja BUKAN statusBarScrim: kasir retail tinggal di dalam
  MainActivity, yang layoutnya sudah punya View ber-id statusBarScrim sendiri.
  Dua View ber-id sama dalam satu jendela membuat findViewById mengembalikan
  yang mana pun yang lebih dulu ditemukan - jenis kesalahan yang hanya muncul
  setelah seseorang menyusun ulang layout induknya.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/topBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
      Tinggi nol di layout; SystemBars.fitStatusScrim() menumbuhkannya
      setinggi bilah status. Di perangkat tanpa bilah status ia tetap nol dan
      tidak memakan ruang.
    -->
    <View
        android:id="@+id/posHeaderScrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/status_bar_brand" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardPosHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="2dp"
        app:cardCornerRadius="@dimen/radius_surface"
        app:cardElevation="2dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="@dimen/topbar_min_height"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="@dimen/pos_header_logo_size"
                android:layout_height="@dimen/pos_header_logo_size"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/cd_shop_logo"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_logo_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBrand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/pos_retail_title"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvShopAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/pos_default_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHeaderBarcode"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:background="@drawable/bg_chip"
                android:contentDescription="@string/cd_barcode_scan"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_barcode"
                app:tint="@color/icon_muted"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
