<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <AutoCompleteTextView
            android:id="@+id/actFromWarehouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_from_warehouse_required"
            android:inputType="text"
            android:completionThreshold="0" />

        <AutoCompleteTextView
            android:id="@+id/actToWarehouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_to_warehouse_required"
            android:inputType="text"
            android:completionThreshold="0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                style="@style/Widget.Valora.EditText"
                android:id="@+id/etBarcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/label_barcode"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnScanBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_scan" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/actProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_select_product_required"
            android:inputType="text"
            android:completionThreshold="0" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/label_unit_required"
            android:textColor="@color/icon_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <AutoCompleteTextView
                android:id="@+id/actUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="0"
                android:hint="@string/hint_select_unit"
                android:inputType="none"
                android:paddingEnd="40dp"
                android:singleLine="true" />

            <!--
              Panah pemilih. Dulu karakter "▼" di dalam TextView: bentuk dan
              ukurannya ikut font perangkat, jadi di sebagian ponsel tampil
              sebagai kotak kosong. Sekarang ikon vektor yang sama dengan
              pemilih lain di aplikasi.
            -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/text_tertiary" />
        </FrameLayout>

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/hint_quantity_required"
            android:inputType="numberDecimal" />

        <TextView
            android:id="@+id/tvQuantityPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/state_info"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAvailableStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/icon_muted"
            android:textSize="13sp" />

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/label_note"
            android:inputType="textMultiLine"
            android:minLines="2" />

    </LinearLayout>

</ScrollView>
