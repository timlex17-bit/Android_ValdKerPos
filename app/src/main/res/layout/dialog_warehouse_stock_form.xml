<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <AutoCompleteTextView
            android:id="@+id/actWarehouse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_select_warehouse_required"
            android:completionThreshold="0"
            android:inputType="text"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <EditText
                style="@style/Widget.Valora.EditText"
                android:id="@+id/etBarcode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/label_barcode"
                android:inputType="text"
                android:singleLine="true" />

            <Button
                android:id="@+id/btnScanBarcode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_scan" />
        </LinearLayout>

        <AutoCompleteTextView
            android:id="@+id/actProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/hint_select_product_required"
            android:completionThreshold="0"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/label_unit_required"
            android:textColor="@color/icon_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <AutoCompleteTextView
                android:id="@+id/actUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:completionThreshold="0"
                android:hint="@string/hint_select_unit"
                android:inputType="none"
                android:paddingEnd="40dp"
                android:singleLine="true" />

            <!--
              Panah pemilih. Dulu karakter "▼" di dalam TextView: bentuk dan
              ukurannya ikut font perangkat, jadi di sebagian ponsel tampil
              sebagai kotak kosong. Sekarang ikon vektor yang sama dengan
              pemilih lain di aplikasi.
            -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/text_tertiary" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/label_quantity"
            android:textColor="@color/icon_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_enter_stock_quantity"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/label_minimum_stock"
            android:textColor="@color/icon_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            style="@style/Widget.Valora.EditText"
            android:id="@+id/etMinStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_enter_minimum_stock_alert"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary" />

        <TextView
            android:id="@+id/tvQuantityPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/state_info"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
