<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu baris laporan laba: tanggal, penjualan, pengeluaran, laba.

  KEEMPAT KOLOM BERBOBOT, BUKAN TIGA

  Sebelumnya hanya kolom tanggal yang berbobot; tiga kolom angka di kanannya
  memakai wrap_content. Selama angkanya pendek - "S:0", "E:0", "P:0" seperti
  di pratinjau - susunan itu terlihat benar. Begitu angkanya menjadi nilai
  sungguhan, ketiganya melebar sesuka isinya dan mendorong diri keluar tepi
  kanan layar pada ponsel 320dp dan 360dp: bukan terpotong, melainkan
  tergambar di luar layar, sehingga kolom laba - satu-satunya angka yang
  dicari pemilik toko di baris ini - justru yang pertama hilang.

  Dengan keempatnya berbobot, lebar dibagi menurut aturan, bukan menurut
  panjang teks yang kebetulan muncul hari itu. Tanggal mendapat dua bagian
  karena ia yang paling panjang; ketiga angka satu bagian masing-masing.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="12dp"
    android:weightSum="5">

    <TextView
        android:id="@+id/tvDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:ellipsize="end"
        android:maxLines="1"
        android:textStyle="bold"
        tools:text="09/03/2026" />

    <TextView
        android:id="@+id/tvS"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        tools:text="S:0" />

    <TextView
        android:id="@+id/tvE"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        tools:text="E:0" />

    <TextView
        android:id="@+id/tvP"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="end"
        android:maxLines="1"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:textStyle="bold"
        tools:text="P:0" />
</LinearLayout>
