<?xml version="1.0" encoding="utf-8"?>
<!--
  Pengaturan printer.

  Layar ini sebelumnya hanya LinearLayout berpadding 16dp berisi TextView,
  Button bawaan, dan ListView - tanpa bilah atas, tanpa tombol kembali, tanpa
  penanganan inset, dan setiap teksnya ditulis langsung di dalam layout dalam
  bahasa Inggris. Di Android 15+ baris "Selected printer" duduk tepat di bawah
  jam, dan satu-satunya cara keluar adalah tombol kembali sistem.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootPrinterSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    tools:context=".print.PrinterSettingsActivity">

    <include layout="@layout/view_topbar" />

    <LinearLayout
        android:id="@+id/printerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <!-- ===== Printer aktif ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Valora.ListCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="12dp"
                android:paddingEnd="10dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/brand_tint"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_print"
                    app:tint="@color/brand_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/printer_selected_label"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvSelectedPrinter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/printer_selected_none"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="RPP02N (66:22:11:AB:CD:EF)" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearPrinter"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="44dp"
                    android:minWidth="0dp"
                    android:text="@string/printer_clear"
                    android:textAllCaps="false"
                    android:textColor="@color/state_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="@dimen/radius_surface_sm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/printer_paired_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/printer_paired_hint"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <ListView
            android:id="@+id/listDevices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@color/stroke_soft"
            android:dividerHeight="1dp"
            android:paddingBottom="12dp" />
    </LinearLayout>

</LinearLayout>
