<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootWorkshopPos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <!-- HEADER -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWorkshopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:strokeColor="#E9EDF5"
        app:strokeWidth="1dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Brand Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="#1F2937"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_shop_logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_logo_circle" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/workshop_default_title"
                        android:textColor="#0F172A"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:text="Valora POS Workshop" />

                    <TextView
                        android:id="@+id/tvShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/workshop_default_address"
                        android:textColor="#98A2B3"
                        android:textSize="11sp"
                        tools:text="Becora, Dili, Timor-Leste" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAddDraft"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:gravity="center"
                    android:minWidth="34dp"
                    android:text="@string/draft_add"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="#22C55E"
                    app:chipCornerRadius="17dp"
                    app:chipMinHeight="34dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />

            </LinearLayout>

            <!-- Draft Chips -->
            <HorizontalScrollView
                android:id="@+id/draftChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDrafts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:chipSpacingVertical="0dp"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDraftA"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:checked="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="@string/draft_a_preview"
                        android:textColor="#166534"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#DCFCE7"
                        app:chipCornerRadius="24dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeColor="#86EFAC"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDraftB"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="@string/draft_b_preview"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#FFFFFF"
                        app:chipCornerRadius="24dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDraftC"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="@string/draft_walkin_preview"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#FFFFFF"
                        app:chipCornerRadius="24dp"
                        app:chipMinHeight="48dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="true" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Customer -->
            <LinearLayout
                android:id="@+id/layoutCustomerInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_customer"
                        android:textAllCaps="true"
                        android:textColor="#B0B7C8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCustomerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/workshop_walk_in_customer"
                        android:textColor="#0F172A"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Walk-in Customer" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCustomer"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_change"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:elevation="0dp"
                    app:rippleColor="#1122C55E" />
            </LinearLayout>

            <!-- Vehicle + Plate -->
            <LinearLayout
                android:id="@+id/layoutVehiclePlate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <!-- Vehicle -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="6dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#E8F9EC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/label_vehicle"
                            android:padding="6dp"
                            android:src="@drawable/ic_car"
                            app:tint="#34C759" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_vehicle"
                            android:textAllCaps="true"
                            android:textColor="#B0B7C8"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtVehicleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/workshop_default_vehicle"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="Toyota Avanza" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Plate -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#E8F9EC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/label_plate"
                            android:padding="6dp"
                            android:src="@drawable/ic_car"
                            app:tint="#34C759" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_plate"
                            android:textAllCaps="true"
                            android:textColor="#B0B7C8"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtPlateNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/workshop_default_plate"
                            android:textColor="#0F172A"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="D 0123 TL" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SUMMARY BOXES -->
    <LinearLayout
        android:id="@+id/layoutQuickStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/cardWorkshopHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Service -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:backgroundTint="#ECFDF3"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1FAE5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/label_service"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtServiceTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_sample_usd"
                    android:textColor="#16A34A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$40.99" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Part -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:backgroundTint="#ECFDF3"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1FAE5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/label_part"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPartsTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_sample_usd"
                    android:textColor="#16A34A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$40.99" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Product -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:backgroundTint="#ECFDF3"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1FAE5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/label_product"
                    android:textColor="#0F172A"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtProductTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_sample_usd"
                    android:textColor="#16A34A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="$40.99" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ITEMS AREA -->
    <LinearLayout
        android:id="@+id/layoutItemsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical"
        app:layout_constrainedHeight="true"
        app:layout_constraintTop_toBottomOf="@id/layoutQuickStats"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtItemsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_items"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF2F7" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWorkspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="4dp"
            android:paddingTop="6dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_product_list" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEF2F7" />

    </LinearLayout>

    <!-- BOTTOM PANEL -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutBottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="14dp"
        app:cardElevation="2dp"
        app:strokeColor="#E8EEF5"
        app:strokeWidth="1dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp">

            <!-- Total + Checkout Row -->
            <LinearLayout
                android:id="@+id/layoutCheckoutSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <!-- Total Info -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:orientation="vertical"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_total"
                        android:textAllCaps="true"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtGrandTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:autoSizeMaxTextSize="21sp"
                        android:autoSizeMinTextSize="15sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/amount_sample_usd"
                        android:textColor="#16A34A"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        tools:text="$1,240.99" />
                </LinearLayout>

                <!-- Checkout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckout"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="0.8"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_checkout"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#22C55E"
                    app:cornerRadius="18dp"
                    app:elevation="0dp"
                    app:rippleColor="#2222C55E" />
            </LinearLayout>

            <!-- ACTION BUTTONS -->
            <LinearLayout
                android:id="@+id/layoutWorkshopActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddService"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:text="@string/label_service"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="#ECFDF3"
                    app:cornerRadius="16dp"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_service"
                    app:iconGravity="textStart"
                    app:iconPadding="3dp"
                    app:iconSize="15dp"
                    app:iconTint="#16A34A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPart"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
