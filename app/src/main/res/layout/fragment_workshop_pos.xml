<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/rootWorkshopPos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB"
    android:clipToPadding="false"
    android:fitsSystemWindows="true"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWorkshopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="#E9EDF5"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="8dp"
                    android:backgroundTint="#1F2937"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_shop_logo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bg_logo_circle" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/tvBrand"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/workshop_default_title"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Valora POS Workshop" />

                    <TextView
                        android:id="@+id/tvShopAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/workshop_default_address"
                        android:textColor="#98A2B3"
                        android:textSize="10sp"
                        tools:text="Becora, Dili" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAddDraft"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:text="@string/draft_add"
                    android:textAlignment="center"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="#22C55E"
                    app:chipCornerRadius="16dp"
                    app:chipMinHeight="32dp"
                    app:chipStrokeWidth="0dp"
                    app:ensureMinTouchTargetSize="false" />
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/draftChipScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupDrafts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="5dp"
                    app:chipSpacingVertical="0dp"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDraftA"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:checked="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="34dp"
                        android:text="@string/draft_a_preview"
                        android:textColor="#166534"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#DCFCE7"
                        app:chipCornerRadius="17dp"
                        app:chipMinHeight="34dp"
                        app:chipStrokeColor="#86EFAC"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDraftB"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="34dp"
                        android:text="@string/draft_b_preview"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#FFFFFF"
                        app:chipCornerRadius="17dp"
                        app:chipMinHeight="34dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipDraftC"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:minHeight="34dp"
                        android:text="@string/draft_walkin_preview"
                        android:textColor="#334155"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:checkedIconVisible="false"
                        app:chipBackgroundColor="#FFFFFF"
                        app:chipCornerRadius="17dp"
                        app:chipMinHeight="34dp"
                        app:chipStrokeColor="#E2E8F0"
                        app:chipStrokeWidth="1dp"
                        app:ensureMinTouchTargetSize="false" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/layoutWorkshopSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:minHeight="30dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtWorkshopJobInfoLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/label_workshop_job_info"
                    android:textAllCaps="true"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectCustomer"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:minHeight="32dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_change"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:backgroundTint="@android:color/transparent"
                    app:elevation="0dp"
                    app:rippleColor="#1122C55E" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/workshop_vehicle_not_selected"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Walk-in Customer • Veikulu belum dipilih" />

            <TextView
                android:id="@+id/txtVehicleSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:visibility="gone"
                android:maxLines="1"
                android:text="@string/workshop_vehicle_not_selected"
                android:textColor="#334155"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Veikulu: CAR - Toyota Hilux - B1234" />

            <TextView
                android:id="@+id/txtWorkshopSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:visibility="gone"
                android:maxLines="1"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/layoutWorkshopChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                app:chipSpacingHorizontal="4dp"
                app:chipSpacingVertical="2dp"
                app:singleLine="true"
                tools:visibility="visible">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMechanicSummary"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="24dp"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    app:chipBackgroundColor="#F8FAFC"
                    app:chipCornerRadius="12dp"
                    app:chipMinHeight="24dp"
                    app:chipStrokeColor="#E2E8F0"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="Mekanik: Antonio" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWorkOrderSummary"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="24dp"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    app:chipBackgroundColor="#F8FAFC"
                    app:chipCornerRadius="12dp"
                    app:chipMinHeight="24dp"
                    app:chipStrokeColor="#E2E8F0"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="WO: WO-001" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBookingSummary"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:minHeight="24dp"
                    android:textColor="#334155"
                    android:textSize="11sp"
                    app:chipBackgroundColor="#F8FAFC"
                    app:chipCornerRadius="12dp"
                    app:chipMinHeight="24dp"
                    app:chipStrokeColor="#E2E8F0"
                    app:chipStrokeWidth="1dp"
                    app:ensureMinTouchTargetSize="false"
                    tools:text="Rezerva: BK-001" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layoutQuickStats"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardWorkshopHeader">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#ECFDF3"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1FAE5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/label_service"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtServiceTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_zero_usd"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="$40.99" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:backgroundTint="#ECFDF3"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1FAE5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/label_part"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPartsTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_zero_usd"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="$40.99" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="#ECFDF3"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#D1FAE5"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/label_product"
                    android:textColor="#0F172A"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtProductTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/amount_zero_usd"
                    android:textColor="#16A34A"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="$40.99" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutItemsContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutQuickStats">

        <TextView
            android:id="@+id/txtItemsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/label_workshop_cart_items"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerWorkspace"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="2dp"
            android:paddingTop="2dp"
            android:paddingEnd="2dp"
            android:paddingBottom="4dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_product_list" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutBottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#E8EEF5"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/layoutCheckoutSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/label_total"
                        android:textAllCaps="true"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtGrandTotal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autoSizeMaxTextSize="21sp"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeStepGranularity="1sp"
                        android:autoSizeTextType="uniform"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/amount_zero_usd"
                        android:textColor="#16A34A"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        tools:text="$1,240.99" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCheckout"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="0.85"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="48dp"
                    android:minHeight="48dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/action_checkout"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#22C55E"
                    app:cornerRadius="16dp"
                    app:elevation="0dp"
                    app:rippleColor="#2222C55E" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutWorkshopActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="4">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPackage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="42dp"
                    android:minHeight="42dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/label_package"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="#ECFDF3"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_service"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconSize="13dp"
                    app:iconTint="#16A34A"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddService"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="42dp"
                    android:minHeight="42dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/label_service"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="#ECFDF3"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_service"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconSize="13dp"
                    app:iconTint="#16A34A"
                    app:strokeColor="#86EFAC"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddPart"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="1"
                    android:minWidth="42dp"
                    android:minHeight="42dp"
                    android:paddingStart="2dp"
                    android:paddingEnd="2dp"
                    android:text="@string/label_part"
                    android:textAllCaps="false"
                    android:textColor="#16A34A"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="#ECFDF3"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_shopping_cart"
                    app:iconGravity="textStart"
                    app:iconPadding="2dp"
                    app:iconSize="13dp"
                    app:iconTint="#16A34A"
                    app:strokeColor="#86EFAC"
