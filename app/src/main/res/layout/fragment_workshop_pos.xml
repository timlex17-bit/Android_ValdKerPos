<?xml version="1.0" encoding="utf-8"?>
<!--
  4c - Kasir bengkel, implementasi 4. Susunan POTRET.

  Urutan bloknya sama persis dengan 3c; yang berganti bahasa visualnya:

      header ungu melengkung
        └ kartu konteks kendaraan DI DALAMNYA + tombol Troka
      tiga kartu aksi cepat: Work order · Rezerva · Istória
      baris bon
      tiga kartu total berwarna: Servisu biru · Peca oranye · Produtu hijau
      kartu kelompok isi
      strip tambah berwarna: Pakote · Servisu · Peca · Produtu
      bilah total melengkung

  Isinya tidak ada di sini. Ketiga bloknya berdiri sebagai berkas sendiri -
  view_workshop_header, view_workshop_body, view_workshop_bottom - dan berkas
  ini hanya menyusunnya. Varian lanskap menyusun ketiga berkas yang SAMA dalam
  dua kolom. Sebelumnya varian itu adalah salinan penuh sepanjang 800 baris,
  dan salinan itu berhenti ikut diperbarui tanpa menimbulkan galat apa pun:
  memutar perangkat menampilkan desain dari dua generasi sebelumnya.

  Badan menggulir, bilah bawah diam. Total dan tombol bayar harus selalu
  terlihat: keduanya yang dituju setiap transaksi, dan mencarinya dengan
  menggulir memperlambat antrean.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWorkshopPos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_ground"
    android:orientation="vertical">

    <include layout="@layout/view_workshop_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="@dimen/pos_gutter"
        android:paddingEnd="@dimen/pos_gutter"
        android:scrollbars="none">

        <include layout="@layout/view_workshop_body" />
    </androidx.core.widget.NestedScrollView>

    <include layout="@layout/view_workshop_bottom" />

</LinearLayout>
