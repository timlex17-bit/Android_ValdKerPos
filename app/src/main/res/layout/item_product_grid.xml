<?xml version="1.0" encoding="utf-8"?>
<!--
  Kartu menu pada kasir restoran (mode grid).

  RESPONSIF LEWAT RASIO, BUKAN TINGGI MATI

  Tinggi gambar dulu angka tetap per ukuran layar (170dp ponsel, 220dp
  tablet). Angka tetap tidak pernah bisa benar: lebar kartu ditentukan jumlah
  kolom, dan jumlah kolom ditentukan lebar daftar yang tersisa setelah kolom
  keranjang - jadi kartu selebar 215dp bisa bergambar 220dp, lebih tinggi
  daripada lebarnya sendiri. Kini gambar memakai rasio 4:3 terhadap lebar
  kartunya, sehingga bentuk kartu sama di ponsel sempit maupun tablet lebar
  tanpa satu pun angka per perangkat.

  Sisa tingginya dipangkas: nama tidak lagi dipaksa dua baris (minLines dua
  membuat kartu bernama pendek setinggi kartu bernama panjang), harga dan
  tombol tambah berbagi satu baris, dan tombolnya jadi tombol ikon bundar -
  label "Tambah ke Keranjang" tidak pernah muat di kartu selebar seperempat
  kolom menu dan sempat terlipat tiga baris sampai terpotong di tengah kata.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/product_card_margin"
    app:cardBackgroundColor="@color/pos_card"
    app:cardCornerRadius="@dimen/pos_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_divider"
    app:strokeWidth="@dimen/pos_hairline"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/surface_subtle"
            android:contentDescription="@string/cd_product_image"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_image_placeholder"
            app:layout_constraintDimensionRatio="H,4:3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_card_padding"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="@dimen/row_card_padding"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/row_name_text"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgProduct"
            tools:text="Nasi Goreng Spesial" />

        <TextView
            android:id="@+id/tvStock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_card_padding"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="@dimen/row_card_padding"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/row_meta_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            tools:text="Stok: 16" />

        <!--
          Harga dan tombol tambah berbagi satu baris; dulu tombolnya selebar
          kartu dan berdiri sendiri di bawah harga, memakan 48dp tinggi hanya
          untuk satu aksi yang juga bisa dilakukan dengan mengetuk kartunya.
        -->
        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_card_padding"
            android:layout_marginEnd="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/brand_primary"
            android:textSize="@dimen/row_price_text"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/btnAdd"
            app:layout_constraintEnd_toStartOf="@id/btnAdd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnAdd"
            tools:text="$1.50" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            style="@style/Widget.Material3.Button"
            android:layout_width="@dimen/product_action_size"
            android:layout_height="@dimen/product_action_size"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="@dimen/row_card_padding"
            android:layout_marginBottom="@dimen/row_card_padding"
            android:contentDescription="@string/pos_add_to_cart"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:backgroundTint="@color/brand_primary"
            app:cornerRadius="@dimen/pos_radius_card"
            app:elevation="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp"
            app:iconTint="@color/text_on_brand"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStock" />

        <!--
          Kendali jumlah. Disembunyikan ProductAdapter - kasir menambah item
          dengan mengetuk kartunya - tapi tetap ada supaya findViewById di
          adapter tidak mengembalikan null, dan supaya mode daftar dan mode
          grid punya susunan yang sama.
        -->
        <LinearLayout
            android:id="@+id/layoutQtyControl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/row_card_padding"
            android:background="@drawable/bg_cart_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/btnAdd"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnAdd">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMinus"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="@dimen/row_stepper_button"
                android:layout_height="@dimen/row_stepper_button"
                android:contentDescription="@string/cd_cart_decrease"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:backgroundTint="@color/surface"
                app:cornerRadius="@dimen/pos_radius_card"
                app:icon="@drawable/ic_remove"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/brand_primary"
                app:strokeColor="@color/pos_divider"
                app:strokeWidth="@dimen/pos_hairline"
                tools:ignore="TouchTargetSizeCheck" />

            <TextView
                android:id="@+id/tvQty"
                android:layout_width="wrap_content"
                android:minWidth="@dimen/row_qty_min_width"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/pos_zero_count"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlus"
                style="@style/Widget.Material3.Button"
                android:layout_width="@dimen/row_stepper_button"
                android:layout_height="@dimen/row_stepper_button"
                android:contentDescription="@string/cd_cart_increase"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:backgroundTint="@color/brand_primary"
                app:cornerRadius="@dimen/pos_radius_card"
                app:elevation="0dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_on_brand"
                tools:ignore="TouchTargetSizeCheck" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
