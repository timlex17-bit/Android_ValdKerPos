<?xml version="1.0" encoding="utf-8"?>
<!--
  Bilah total + checkout.

  Tombolnya dulu berbagi baris dengan angka total memakai bobot 1.05 : 0.95,
  jadi pada ponsel 320dp label "Checkout" mepet ke tepi tombol dan angka total
  yang panjang langsung terpotong. Sekarang total berdiri sendiri di atas dan
  tombolnya selebar penuh: lebih mudah ditekan sambil memegang ponsel satu
  tangan, dan angka totalnya punya seluruh lebar layar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/label_total"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtGrandTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="24sp"
            android:autoSizeMinTextSize="15sp"
            android:autoSizeTextType="uniform"
            android:gravity="end"
            android:maxLines="1"
            android:text="@string/amount_zero_usd"
            android:textColor="@color/brand_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            tools:text="$1,284.50" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckout"
        style="@style/Widget.Valora.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="@dimen/pos_checkout_button_min_height"
        android:text="@string/action_checkout"
        app:icon="@drawable/ic_bag"
        app:iconGravity="textStart"
        app:rippleColor="#33FFFFFF" />

</LinearLayout>
