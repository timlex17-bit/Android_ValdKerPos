<?xml version="1.0" encoding="utf-8"?>
<!--
  Bilah total + bayar - implementasi 4.

  Lembar putih yang melengkung di dua sudut ATAS saja, duduk di dasar layar.
  Lengkungan itu yang memisahkannya dari daftar di atasnya - bukan garis,
  bukan bayangan tebal.

  Susunannya: label kecil, angka total besar, lalu lencana jumlah item di
  kanan. Angka totalnya memakai berat 800 dan ukuran terbesar di seluruh
  layar, karena satu angka inilah yang dibaca berulang kali sambil tangan
  menghitung uang.

  Tombol bayar mati terlihat SEBELUM ditekan ketika keranjang kosong - abu,
  bukan ungu pucat - supaya kasir tidak menekannya lalu menunggu.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pos_bottom_sheet"
    android:orientation="vertical"
    android:paddingStart="@dimen/pos_space_4"
    android:paddingTop="@dimen/pos_gap"
    android:paddingEnd="@dimen/pos_space_4"
    android:paddingBottom="@dimen/pos_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.Pos.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/archivo_semibold"
                android:text="@string/pos_total_label"
                android:textSize="12sp" />

            <!--
              autoSize, bukan ukuran mati. Bilah ini juga dipakai sebagai
              kolom samping selebar 220dp pada ponsel lanskap, dan pada
              ponsel 320dp lencana jumlah item di sebelahnya ikut memakan
              lebar. Dengan 28sp mati, total enam digit terpotong di kedua
              keadaan itu - dan yang hilang justru digit paling depan.
            -->
            <TextView
                android:id="@+id/txtGrandTotal"
                style="@style/TextAppearance.Pos.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:autoSizeMaxTextSize="@dimen/pos_text_display"
                android:autoSizeMinTextSize="18sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:text="@string/amount_zero_usd"
                tools:text="$70.00" />
        </LinearLayout>

        <!--
          Lencana jumlah item, hijau. Hijau di sini bukan "jenis produk"
          melainkan "sudah terkumpul" - satu-satunya tempat hijau dipakai di
          luar keluarga Produtu, dan dipisahkan jelas dari angka uangnya.
        -->
        <TextView
            android:id="@+id/txtCheckoutCount"
            style="@style/TextAppearance.Pos.Badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pos_space_2"
            android:background="@drawable/bg_pos_pill_green"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:minHeight="26dp"
            android:paddingStart="@dimen/pos_gap_sm"
            android:paddingEnd="@dimen/pos_gap_sm"
            android:textColor="@color/pos_green_deep"
            android:textSize="11.5sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_pos_basket"
            app:drawableTint="@color/pos_green_deep"
            tools:text="3 item"
            tools:visibility="visible" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckout"
        style="@style/Widget.Pos.MaterialPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pos_gap"
        android:text="@string/pos_pay"
        app:icon="@drawable/ic_pos_wallet"
        app:iconGravity="textStart"
        app:iconTint="@color/pos_on_accent" />

</LinearLayout>
