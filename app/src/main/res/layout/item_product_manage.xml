<?xml version="1.0" encoding="utf-8"?>
<!--
  Kartu produk pada layar kelola produk.

  Satu berkas untuk semua ukuran layar: ukurannya dari token @dimen yang
  berbeda per layar, bukan dari salinan di layout-sw600dp. Salinan itu sudah
  menyimpang - yang ini mematok tinggi gambar 170dp sementara salinannya
  memakai @dimen, jadi kartu di tablet berubah tinggi tergantung berkas mana
  yang kebetulan terpilih.
-->
<com.google.android.material.card.MaterialCardView
    style="@style/Widget.Valora.ItemCard"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/product_card_margin">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- IMAGE -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="0dp"
            android:layout_height="@dimen/product_card_image_height"
            android:contentDescription="Product image"
            android:scaleType="centerCrop"
            android:src="@android:color/darker_gray"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Soft Overlay -->
        <View
            android:id="@+id/imgOverlay"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_image_top_fade"
            app:layout_constraintTop_toTopOf="@id/imgProduct"
            app:layout_constraintStart_toStartOf="@id/imgProduct"
            app:layout_constraintEnd_toEndOf="@id/imgProduct" />

        <!-- Stock Chip -->
        <TextView
            android:id="@+id/tvChipStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_chip_soft"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="STOCK"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/imgProduct"
            app:layout_constraintTop_toTopOf="@id/imgProduct" />

        <!-- BODY -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="@dimen/product_card_padding"
            app:layout_constraintTop_toBottomOf="@id/imgProduct"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Product Name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/product_name_text"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Stock: 0 • $0.00"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/product_meta_text"
                app:layout_constraintTop_toBottomOf="@id/tvName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ACTIONS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvMeta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!--
                  Dua tombol yang harus SELALU kembar: lebar 50:50 lewat
                  bobot (bukan angka dp, supaya ikut lebar kolom grid berapa
                  pun), dan tinggi match_parent.

                  match_parent di sini bukan gaya penulisan: di LinearLayout
                  mendatar yang tingginya wrap_content, anak ber-match_parent
                  mendapat tinggi anak tertinggi. Artinya kedua tombol pasti
                  setinggi satu sama lain apa pun yang terjadi pada teksnya -
                  bukan kebetulan sama karena isinya kebetulan sama panjang.

                  Jaraknya satu sumber saja: @dimen/row_action_gap. Sebelum
                  ini ada Space 10dp DAN margin 8dp sekaligus, jadi jaraknya
                  18dp dan 18dp itu ikut memakan lebar yang dibutuhkan kata
                  "Delete".
                -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.Valora.RowAction.Edit.Compact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:minHeight="@dimen/row_action_min_height"
                    android:text="@string/action_edit" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Valora.RowAction.Delete.Compact"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/row_action_gap"
                    android:minHeight="@dimen/row_action_min_height"
                    android:text="@string/action_delete" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>