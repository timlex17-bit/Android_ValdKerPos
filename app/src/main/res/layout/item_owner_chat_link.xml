<?xml version="1.0" encoding="utf-8"?>
<!--
  Satu pranala yang disarankan asisten. Tinggi minimumnya 44dp supaya tetap
  bisa disentuh dengan nyaman; versi lama memakai padding piksel mentah
  sehingga di layar rapat tingginya hanya sekitar 20dp.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/bg_chat_link"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/tvLinkTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/brand_on_tint"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Lihat laporan penjualan" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_forward_24"
        app:tint="@color/brand_on_tint" />

</LinearLayout>
