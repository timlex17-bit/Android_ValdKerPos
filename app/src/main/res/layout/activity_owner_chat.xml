<?xml version="1.0" encoding="utf-8"?>
<!--
  Owner Chat.

  Yang berubah dari versi sebelumnya:

  * Bilah atasnya putih dan tidak menangani inset sama sekali, jadi di
    Android 15+ judul "Owner Chat" duduk tepat di bawah jam dan ikon baterai.
    Sekarang memakai bilah ungu bersama yang tumbuh sampai ke belakang bilah
    status seperti layar lain.
  * ProgressBar ditumpuk persis di atas tombol kirim, sehingga saat menunggu
    jawaban tombolnya tertutup lingkaran berputar. Status "sedang mengetik"
    kini muncul di bilah atas dan sebagai gelembung di daftar, tempat yang
    memang dilihat orang saat menunggu balasan.
  * Bilah input tidak ikut naik saat papan ketik muncul di perangkat yang
    jendelanya tidak diubah ukurannya; sekarang ditangani lewat inset IME.
  * tools:listitem menunjuk ke @layout/item_chat_message yang tidak pernah
    ada, jadi pratinjaunya selalu kosong.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOwnerChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical"
    tools:context=".ui.ownerchat.OwnerChatActivity">

    <!-- ===================== Bilah atas ===================== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand_primary"
        android:baselineAligned="false"
        android:elevation="3dp"
        android:gravity="center_vertical"
        android:minHeight="@dimen/topbar_min_height"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/topbar_icon_size"
            android:layout_height="@dimen/topbar_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_back"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_on_brand" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            app:cardBackgroundColor="#F1E3FF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_owner_chat_avatar"
                android:padding="7dp"
                android:src="@drawable/ic_chat_bot"
                app:tint="@color/brand_primary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/owner_chat_title"
                android:textColor="@color/text_on_brand"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dotStatus"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="#7BF1A8" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/owner_chat_status_ready"
                    android:textColor="@color/text_on_brand"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="@dimen/topbar_icon_size"
            android:layout_height="@dimen/topbar_icon_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/owner_chat_clear"
            android:padding="9dp"
            android:src="@drawable/ic_refresh"
            app:tint="@color/text_on_brand" />
    </LinearLayout>

    <!-- ===================== Percakapan ===================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        tools:itemCount="3"
        tools:listitem="@layout/item_owner_chat_bot" />

    <!-- ===================== Saran pertanyaan ===================== -->
    <!--
      Hanya terlihat selama percakapan masih kosong. Tiga pertanyaan pembuka
      jauh lebih berguna daripada layar kosong: pemilik toko tidak perlu
      menebak apa yang bisa ditanyakan.
    -->
    <LinearLayout
        android:id="@+id/suggestionScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="4dp"
            android:text="@string/owner_chat_suggestions_title"
            android:textColor="@color/text_tertiary"
            android:textSize="11sp"
            android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="6dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestSales"
                style="@style/Widget.Valora.FilterChip"
                android:text="@string/owner_chat_suggestion_sales" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestStock"
                style="@style/Widget.Valora.FilterChip"
                android:text="@string/owner_chat_suggestion_stock" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestExpense"
                style="@style/Widget.Valora.FilterChip"
                android:text="@string/owner_chat_suggestion_expense" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    </LinearLayout>

    <!-- ===================== Bilah input ===================== -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:baselineAligned="false"
        android:elevation="8dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_chat_field"
            android:gravity="center_vertical"
            android:hint="@string/owner_chat_hint"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="11dp"
            android:paddingEnd="16dp"
            android:paddingBottom="11dp"
            android:scrollbars="vertical"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/sendContainer"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="@color/brand_primary"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/owner_chat_send"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_send"
                app:tint="@color/text_on_brand" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</LinearLayout>
