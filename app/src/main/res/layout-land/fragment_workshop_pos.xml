<?xml version="1.0" encoding="utf-8"?>
<!--
  4c - Kasir bengkel, ponsel yang dimiringkan.

  Memakai <include> yang sama persis dengan potret - header, badan, dan lembar
  total adalah berkas yang sama - hanya disusun dua kolom.

  MENGAPA TIDAK DITUMPUK SEPERTI POTRET

  Dalam lanskap tinggi layar ponsel tinggal sekitar 360dp. Kepala berikut kartu
  kendaraannya memakan sekitar 130dp dan lembar total sekitar 170dp, sehingga
  yang tersisa untuk daftar barang - satu-satunya bagian yang benar-benar
  dikerjakan kasir - hanya sekitar 60dp, yaitu kurang dari dua baris. Layarnya
  tidak rusak, semuanya masih bisa digulir, tapi ruang kerjanya tinggal sepotong
  pita tipis.

  Dengan lembar total dipindah ke samping, badan mendapat hampir seluruh sisa
  tinggi - sekitar 230dp, hampir empat kali lipat - dan total berikut tombol
  bayarnya tetap terlihat sepanjang waktu.

  BERKAS INI JUGA DIPAKAI TABLET YANG MENDATAR

  Tidak ada varian layout-sw600dp untuk kasir bengkel, dan aturan
  "smallest-width mengalahkan orientasi" hanya memilih di antara varian yang
  ADA. Karena satu-satunya varian mendatar adalah berkas ini, tablet 10 dan 13
  inci yang dipegang mendatar ikut memakainya - dan memang seharusnya begitu:
  susunan dua kolom justru paling masuk akal di layar selebar itu.

  Konsekuensinya kolom kanan harus tahan pada lebar 220dp maupun 320dp, dan
  lembar total di dalamnya tidak boleh memakai pias selebar pos_gutter -
  lihat catatan di view_workshop_bottom.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWorkshopPos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_ground"
    android:orientation="vertical">

    <include layout="@layout/view_workshop_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <include layout="@layout/view_workshop_body" />
        </androidx.core.widget.NestedScrollView>

        <!--
          Kolom kanan. Strip tambah yang di potret berjajar empat kini
          menyempit jadi kolom selebar pos_workshop_panel_width; labelnya boleh
          melipat jadi dua baris - Widget.Pos.AddCell memakai wrap_content
          berikut minHeight, jadi selnya ikut memanjang alih-alih memotong
          hurufnya.

          Kolomnya MENGGULIR. Tanpa itu, LinearLayout mengukur lembar total -
          yang tingginya mengikuti isi - dengan AT_MOST sebesar sisa ruang,
          dan pada ponsel lanskap dengan skala huruf 1,3x sisa itu lebih kecil
          daripada yang dibutuhkan: tombol bayarnya tergencet sampai setinggi
          tujuh dp dan hurufnya terpotong. Digulir, ia selalu utuh.

          fillViewport membuat isinya tetap menempel ke dasar kolom selama
          masih muat, lewat Space berbobot di atasnya.
        -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="@dimen/pos_workshop_panel_width"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:minWidth="@dimen/pos_workshop_panel_width"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <include layout="@layout/view_workshop_bottom" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</LinearLayout>
