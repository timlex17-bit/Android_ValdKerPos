<?xml version="1.0" encoding="utf-8"?>
<!--
  POS kasir (retail) - lanskap.

  Memakai <include> yang sama persis dengan potret, hanya disusun dua kolom:
  daftar item di kiri, ringkasan dan tombol checkout menempel di kanan supaya
  keduanya terlihat bersamaan pada layar yang pendek.

  Versi lanskap sebelumnya adalah salinan terpisah yang sudah menyimpang:
  seluruh chip bon (chipDraftA/B/C, chipGroupDrafts, chipAddDraft) tidak ada
  di sana, jadi memutar perangkat membuat daftar bon terbuka hilang, dan
  setiap penyesuaian di potret harus disalin tangan ke sini.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRetailPos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:orientation="vertical">

    <include layout="@layout/view_pos_topbar" />

    <include layout="@layout/view_pos_controls" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView

            style="@style/Widget.Valora.PanelCard"
            android:id="@+id/cardRetailWorkspace"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1">

            <include layout="@layout/view_pos_list" />
        </com.google.android.material.card.MaterialCardView>

        <!--
          Kolom kanan. Lebarnya dibatasi min/max supaya pada ponsel lanskap
          sempit ia tidak memakan ruang daftar, dan pada tablet tidak
          melebar jadi kolom kosong.
        -->
        <LinearLayout
            android:layout_width="@dimen/pos_side_panel_width"
            android:layout_height="match_parent"
            android:minWidth="@dimen/pos_side_panel_min_width"
            android:orientation="vertical">

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include layout="@layout/view_pos_checkout" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
