<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- CAMERA FOR BARCODE -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- CAMERA FEATURE -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false"/>

    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BLUETOOTH -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>

    <application
        android:name=".ValdkerApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ValdKer"
        android:enableOnBackInvokedCallback="true">

        <!-- ✅ LOGIN -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ NEW: HOME DASHBOARD -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.dashboard.HomeDashboardActivity"
            android:windowSoftInputMode="adjustPan"
            android:exported="false" />

        <!-- ✅ MAIN -->
        <activity
            android:name=".ui.offlineorders.PendingOrdersActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- ✅ CHECKOUT WEBVIEW (HYBRID) -->
        <activity
            android:name=".ui.checkout.CheckoutActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- ✅ PRINTER SETTINGS -->
        <activity
            android:name=".print.PrinterSettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.ownerchat.OwnerChatActivity"
            android:exported="false" />

        <activity
            android:name=".ui.productreturns.ProductReturnDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.inventorycount.InventoryCountDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.stockadjustments.StockAdjustmentDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.stockmovements.StockMovementDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.BankAccountActivity"
            android:exported="false" />
        <activity
            android:name=".ui.purchasereturns.PurchaseReturnListActivity"
            android:exported="false" />
        <activity
            android:name=".ui.workshop.VehiclesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.workshop.MechanicsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.workshop.WorkOrdersActivity"
            android:exported="false" />
        <activity
            android:name=".ui.workshop.ServiceHistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.workshop.ServicePackagesActivity"
            android:exported="false" />
        <activity
            android:name=".ui.workshop.BookingsActivity"
            android:exported="false" />

    </application>

</manifest>
