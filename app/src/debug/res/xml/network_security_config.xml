<?xml version="1.0" encoding="utf-8"?>
<!--
  Hanya varian DEBUG. Berkas ini tidak boleh dipindahkan ke src/main:
  src/main menyetel android:usesCleartextTraffic="false" dan tidak menunjuk
  network-security-config sama sekali, jadi build RILIS menolak seluruh HTTP
  polos. Itu jaminan yang sebenarnya, dan tidak disentuh berkas ini.

  Kenapa di sini <base-config> dan bukan daftar <domain>:

  network-security-config TIDAK punya sintaks rentang/CIDR. Elemen <domain>
  hanya menerima satu hostname atau satu IP literal - tidak ada cara menulis
  192.168.0.0/16 di XML ini, dan menuliskan 65.536 entri jelas bukan jawaban.
  Sementara itu alamat backend bisa diubah saat aplikasi berjalan (kolom
  server di layar Login dan di Settings), jadi host yang diizinkan memang
  tidak diketahui pada waktu build.

  Karena itu pembatasannya dipindah ke tempat yang memang bisa menyatakan
  rentang: ApiConfig.validateBaseUrl() menolak http:// ke host yang bukan
  jaringan privat (10/8, 172.16/12, 192.168/16, loopback, link-local, .local)
  sebelum alamatnya sempat disimpan. Jadi "bukan semua host" ditegakkan di
  kode, bukan di XML ini - dan pesannya jelas ke pengguna, bukan timeout
  jaringan yang membingungkan.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
